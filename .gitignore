# Dépendances
node_modules/
.pnp/
.pnp.*
.yarn/

# Documentation
CLAUDE.md
docs/

# Sortie de build — jamais versionnée : elle est reconstruite à chaque
# déploiement à partir du commit vérifié.
dist/
.astro/
.output/
.vercel/
.netlify/
.wrangler/

# Tests
test-results/
playwright-report/
blob-report/
.playwright/
playwright/.cache/
coverage/
.nyc_output/

# Secrets et environnement — rien de tout cela ne doit être déployé ni poussé.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key
*.p12
*.pfx
.cloudflare/
.wrangler-config.json

# Journaux et fichiers temporaires
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.tmp/
tmp/
*.tmp

# Outillage d'agents — hors dépôt.
#
# Les skills installés localement (Claude Code, gstack, emilkowalski/skills)
# sont de l'outillage personnel, pas du code du projet. Trois raisons de ne pas
# les versionner ici :
#   - ce sont des milliers de lignes de contenu tiers dans un dépôt public
#     publié sous AGPL, avec une question de licence sans réponse claire ;
#   - ils changent au rythme de leurs auteurs, pas à celui du projet ;
#   - ils noieraient les diffs de revue.
#
# CLAUDE.md décrit quelles skills utiliser et dans quel ordre de priorité :
# c'est la seule chose qui doit vivre dans le dépôt.
.agents/
.claude/skills/
skills-lock.json

# En revanche, un réglage Claude Code propre au projet a sa place dans le
# dépôt : il fait partie de la façon de travailler ici, pas de l'outillage
# personnel. On ignore donc les skills, pas tout .claude/.
.claude/*
!.claude/settings.json

# Éditeurs et systèmes
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
