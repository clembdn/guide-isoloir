---
/*
 * Page de thème : pour chaque affirmation du thème, la position de chaque
 * candidat en lice.
 *
 * ELLE RÉPOND À « QUE PENSENT LES CANDIDATS DE X ? », pas à « que pense Y ? » —
 * c'est la fiche candidat. Aucune citation n'est donc répétée ici : chaque nom
 * renvoie, par une ancre, à la position détaillée et sourcée sur la fiche.
 * Deux pages au contenu identique se feraient concurrence dans les moteurs, et
 * le cahier des charges l'interdit.
 *
 * NEUTRALITÉ : les groupes suivent l'échelle du test, du plein accord au plein
 * désaccord, et les noms l'ordre alphabétique. Aucun candidat n'est mis en
 * avant, et un groupe vide est affiché comme tel plutôt que masqué, pour que
 * l'échelle reste lisible entière. Les candidats sans position sont nommés :
 * les omettre laisserait croire qu'ils ne sont pas en lice.
 *
 * `direction` n'est jamais lu ici : les questions arrivent projetées.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import DerniereMiseAJour from "../../components/DerniereMiseAJour.astro";
import { pagesThemes, type CandidatCite, type PageTheme } from "../../lib/fiches";
import { SITE_NAME, SITE_URL } from "../../lib/site";

export function getStaticPaths() {
  return pagesThemes().map((theme) => ({ params: { slug: theme.slug }, props: { theme } }));
}

type Props = { theme: PageTheme };
const { theme } = Astro.props;

const UPDATED = theme.misAJour;

const url = new URL(`/themes/${theme.slug}`, SITE_URL).href;

/*
 * Nuances affichées à côté du nom, et seulement celles qui changent la lecture
 * du cran : une reprise de parti, une citation partielle, une valeur déduite.
 * La confiance dans la source reste sur la fiche, où elle s'explique.
 */
const NUANCE_ADEQUATION: Record<string, string> = {
  partielle: "citation partielle",
  deduite: "valeur déduite",
};

function nuances(cite: CandidatCite): string {
  return [
    cite.heriteDe !== null ? `position de ${cite.heriteDe}, reprise` : null,
    cite.adequation !== null ? (NUANCE_ADEQUATION[cite.adequation] ?? null) : null,
  ]
    .filter((nuance) => nuance !== null)
    .join(" ; ");
}

function lien(cite: CandidatCite, questionId: string): string {
  return `/candidats/${cite.slug}#${questionId}`;
}

const filAriane = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    {
      "@type": "ListItem",
      position: 2,
      name: "Thèmes",
      item: new URL("/themes", SITE_URL).href,
    },
    { "@type": "ListItem", position: 3, name: theme.nom, item: url },
  ],
};
---

<BaseLayout
  title={`${theme.nom} : les positions des candidats à la présidentielle 2027`}
  description={`Ce que disent les candidats à l'élection présidentielle de 2027 sur ${theme.affirmations.length} affirmations du thème « ${theme.nom} », avec le lien vers chaque citation sourcée et datée.`}
  updated={UPDATED}
>
  <nav class="fil-ariane" aria-label="Fil d'Ariane">
    <a href="/">{SITE_NAME}</a>
    <span aria-hidden="true">/</span>
    <a href="/themes">Thèmes</a>
  </nav>

  <h1>{theme.nom}</h1>
  <DerniereMiseAJour date={UPDATED} />

  <p class="question">
    Les {theme.affirmations.length} affirmations du test sur ce thème, et la position de chaque candidat
    en lice. Chaque nom mène à la citation, à sa source et à sa date.
  </p>

  <p>
    Une position reprise du parti faute de déclaration personnelle, une citation qui ne porte que
    sur une partie de l'affirmation et une valeur déduite sont signalées à côté du nom. Pour situer
    vos propres réponses, <a href="/test">faites le test</a>.
  </p>

  {
    theme.affirmations.map((affirmation) => (
      <section class="affirmation" aria-labelledby={affirmation.question.id}>
        <h2 id={affirmation.question.id}>{affirmation.question.texte}</h2>
        <p class="definition">
          {affirmation.question.infobulle} Source :{" "}
          <a href={affirmation.definitionSource.url} rel="noreferrer">
            {affirmation.definitionSource.titre}
          </a>
          , {affirmation.definitionSource.editeur}.
        </p>
        <dl class="groupes">
          {affirmation.groupes.map((groupe) => (
            <>
              <dt>{groupe.libelle}</dt>
              <dd>
                {groupe.candidats.length === 0 ? (
                  <span class="vide">Aucun candidat</span>
                ) : (
                  <ul>
                    {groupe.candidats.map((cite) => (
                      <li>
                        <a href={lien(cite, affirmation.question.id)}>{cite.nom}</a>
                        {nuances(cite) && <span class="nuance"> — {nuances(cite)}</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </dd>
            </>
          ))}
          <dt>Position inconnue</dt>
          <dd>
            {affirmation.inconnus.length === 0 ? (
              <span class="vide">Aucun candidat</span>
            ) : (
              <ul class="inconnus">
                {affirmation.inconnus.map((cite) => (
                  <li>
                    <a href={lien(cite, affirmation.question.id)}>{cite.nom}</a>
                  </li>
                ))}
              </ul>
            )}
          </dd>
        </dl>
      </section>
    ))
  }

  <p class="signature">
    La <a href="/methodologie">méthodologie</a> explique comment une position est établie. Un candidat
    sans position documentée n'est ni pour ni contre : on ne sait pas encore, et le test l'écarte du calcul
    sur cette affirmation. Une erreur ? La procédure de signalement est décrite dans la{" "}
    <a href="/charte-editoriale">charte éditoriale</a>.
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(filAriane)} is:inline />
</BaseLayout>

<style>
  /* Un filet par affirmation : il sépare deux questions, il ne décore pas. */
  .affirmation {
    margin-top: var(--pas-5);
    padding-top: var(--pas-3);
    border-top: 1px solid var(--couleur-trait);
  }

  .affirmation h2 {
    font-size: var(--t-h3);
    margin-top: 0;
  }

  .definition {
    font-size: var(--t-petit);
    color: var(--couleur-encre-faible);
  }

  .groupes {
    margin: var(--pas-3) 0 0;
  }

  .groupes dt {
    font-weight: 600;
    margin-top: var(--pas-3);
  }

  .groupes dd {
    margin: var(--pas-1) 0 0;
  }

  .groupes ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .groupes li {
    margin-bottom: var(--pas-1);
  }

  .vide,
  .nuance {
    color: var(--couleur-encre-faible);
  }

  /*
   * Les candidats sans position forment la liste la plus longue tant que les
   * programmes ne sont pas publiés. En ligne plutôt qu'en colonne, pour que
   * l'absence reste nommée sans occuper plus de place que ce qu'on sait.
   */
  .inconnus {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--pas-3);
  }
</style>
