---
/*
 * Page d'un article de /comprendre.
 *
 * Seuls les articles relus (`relecture: verifie`) sont générés. Un brouillon
 * n'a pas d'URL : il ne peut donc pas fuiter par un lien direct.
 */
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { articlesPublies, teinteArticle } from "../../lib/comprendre";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const articles = await articlesPublies();
  return articles.map((article, index) => ({
    params: { id: article.id },
    props: { article, teinte: teinteArticle(index) },
  }));
}) satisfies GetStaticPaths;

const { article, teinte } = Astro.props;
const { Content, headings } = await render(article);

/* Le sommaire ne reprend que les sections : les titres de niveau 2. */
const titres = headings
  .filter((titre) => titre.depth === 2)
  .map(({ slug, text }) => ({ id: slug, texte: text }));
---

<ArticleLayout article={article} corps={article.body ?? ""} titres={titres} teinte={teinte}>
  <Content />
</ArticleLayout>
