---
/*
 * Fiche candidat : où en est sa candidature, ce que l'on sait de son
 * programme, et ce qu'il a dit sur chacune des affirmations du test.
 *
 * UNE PAGE PAR CANDIDAT SUIVI, DOCUMENTÉ OU NON. Ne publier que les fiches
 * remplies donnerait une présence en ligne aux seuls candidats les mieux
 * couverts par la presse — le biais que `CLAUDE.md` interdit ailleurs. Une
 * fiche vide dit, datée et sourcée, que le candidat est en lice et qu'on ne
 * sait encore rien de ses positions. C'est une information.
 *
 * HTML STATIQUE, SANS ÎLOT. Beaucoup de robots d'IA n'exécutent pas de
 * JavaScript : une position qui ne se lit qu'après hydratation n'existe pas
 * pour eux, et c'est précisément ce qu'on leur demande de citer. Le seul
 * script est celui du sommaire, qui ne fait que marquer la section en cours.
 *
 * DEUX REGISTRES, DEUX SECTIONS, JAMAIS MÉLANGÉS (25 septembre 2026). « Son
 * programme » montre les propositions, qui n'entrent dans aucun calcul ; « Ses
 * positions sur le test » montre les positions, les seules qui comptent dans
 * le score. Les confondre ferait croire qu'une mesure de programme pèse sur
 * le résultat, ou qu'une position codée est tout le programme.
 *
 * LA POSITION AFFICHÉE EST CELLE DU MOTEUR, choisie par le même résolveur que
 * le test (voir `src/lib/fiches.ts`). Une reprise de parti est nommée comme
 * telle, jamais présentée comme une déclaration du candidat.
 *
 * `direction` n'est jamais lu ici : les questions arrivent projetées.
 */
import PageLecture from "../../layouts/PageLecture.astro";
import DerniereMiseAJour from "../../components/DerniereMiseAJour.astro";
import Portrait from "../../components/candidats/Portrait.astro";
import EtapeCandidature from "../../components/candidats/EtapeCandidature.astro";
import Proposition from "../../components/candidats/Proposition.astro";
import MarquePosition from "../../components/themes/MarquePosition.astro";
import Icone from "../../components/Icone.astro";
import EtapesCandidature from "../../components/schemas/EtapesCandidature.astro";
import { fiches, NOMBRE_AFFIRMATIONS, type Fiche } from "../../lib/fiches";
import { ECHELLE, LIBELLES_SENS, nuanceDe, sensDe } from "../../lib/echelle";
import { LIBELLES_ADEQUATION, LIBELLES_CONFIANCE } from "../../lib/libelles";
import { formatDateFr } from "../../lib/date";
import { SITE_NAME, SITE_URL } from "../../lib/site";

export function getStaticPaths() {
  return fiches().map((fiche) => ({ params: { slug: fiche.acteur.slug }, props: { fiche } }));
}

type Props = { fiche: Fiche };
const { fiche } = Astro.props;
const { acteur, candidature } = fiche;
const nom = acteur.name;

const LIBELLE_VALEUR = new Map(ECHELLE.map((cran) => [cran.valeur, cran.libelle]));

/*
 * Verdict d'une position, dans le code des pages de thème : « Pour »,
 * « Plutôt contre », « Ni pour ni contre ». La valeur exacte de l'échelle du
 * test reste affichée juste à côté, en toutes lettres : le verdict la range,
 * il ne la remplace pas.
 */
function verdict(valeur: (typeof ECHELLE)[number]["valeur"]): string {
  const sens = LIBELLES_SENS[sensDe(valeur)];
  const nuance = nuanceDe(valeur);
  return nuance ? `${nuance} ${sens.toLowerCase()}` : sens;
}

/*
 * Bilan en pastilles, en tête des positions : combien de pour, de contre, de
 * « ni l'un ni l'autre », et combien sans position connue. Même code que le
 * sommaire des pages de thème ; le calcul vit dans `fiches.ts`, partagé avec
 * la liste des candidats.
 */
const bilan = (["pour", "contre", "neutre", "inconnu"] as const)
  .map((sens) => ({ sens, nombre: fiche.bilan[sens] }))
  .filter((ligne) => ligne.sens !== "neutre" || ligne.nombre > 0);

/** « 1 affirmation », « 2 affirmations ». Zéro prend le singulier en français. */
function accorder(nombre: number, singulier: string, pluriel: string): string {
  return `${nombre} ${nombre > 1 ? pluriel : singulier}`;
}

/*
 * Décompte des positions, construit ici plutôt que dans le gabarit : la
 * ponctuation dépend de la ligne qui se trouve être la dernière, et trois
 * conditions imbriquées dans le HTML rendaient la phrase fausse sans que
 * personne ne le voie à la relecture.
 */
const decompte = [
  ...(fiche.personnelles > 0
    ? [
        `${accorder(fiche.personnelles, "issue", "issues")} de déclarations ou de documents de ${nom}`,
      ]
    : []),
  ...fiche.reprises.map(
    (reprise) =>
      `${accorder(reprise.nombre, "reprise", "reprises")} de la position de ${reprise.nom}, faute de déclaration personnelle`,
  ),
  ...(fiche.inconnues.length > 0 ? [`${fiche.inconnues.length} sans position connue`] : []),
];

const sommaire = [
  { id: "programme", texte: "Son programme" },
  { id: "positions", texte: "Ses positions sur le test" },
  ...(fiche.inconnues.length > 0
    ? [{ id: "sans-position", texte: "Sans position documentée" }]
    : []),
];

const url = new URL(`/candidats/${acteur.slug}`, SITE_URL).href;

const description =
  fiche.documentees === 0 && fiche.nombrePropositions === 0
    ? `${nom}, élection présidentielle de 2027 : où en est sa candidature, datée et sourcée. Aucune proposition ni position n'est encore documentée.`
    : `${nom}, élection présidentielle de 2027 : où en est sa candidature, ${accorder(fiche.nombrePropositions, "proposition relevée", "propositions relevées")} de son programme, et ses positions sur ${fiche.documentees} des ${NOMBRE_AFFIRMATIONS} affirmations du test, avec citation, source et date.`;

const filAriane = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    {
      "@type": "ListItem",
      position: 2,
      name: "Candidats",
      item: new URL("/candidats", SITE_URL).href,
    },
    { "@type": "ListItem", position: 3, name: nom, item: url },
  ],
};

/*
 * `Person` et rien de plus. Aucune propriété n'est déduite : pas de date de
 * naissance, pas de fonction, rien qui ne soit déjà une donnée sourcée du
 * dépôt. `memberOf` vient de la chaîne de reprise, comme le logo affiché.
 */
const personne = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: nom,
  url,
  ...(fiche.portrait ? { image: new URL(fiche.portrait, SITE_URL).href } : {}),
  ...(fiche.parti ? { memberOf: { "@type": "Organization", name: fiche.parti.nom } } : {}),
};
---

<PageLecture
  title={`${nom} : programme et positions pour la présidentielle 2027`}
  description={description}
  updated={fiche.misAJour}
  teinte="t-violet"
  sommaire={sommaire}
  libelleSommaire="Sur cette fiche"
>
  <Fragment slot="tete">
    <nav class="fil-ariane" aria-label="Fil d'Ariane">
      <a href="/">{SITE_NAME}</a>
      <span aria-hidden="true">/</span>
      <a href="/candidats">Candidats</a>
    </nav>

    <div class="identite">
      <Portrait nom={nom} chemin={fiche.portrait} taille={120} differe={false} />
      <div>
        <h1>{nom}</h1>
        {
          fiche.parti ? (
            <p class="parti">
              {fiche.parti.logo && <img class="logo" src={fiche.parti.logo} alt="" height="22" />}
              <span>{fiche.parti.nom}</span>
            </p>
          ) : (
            <p class="parti">Sans parti rattaché par les sources lues</p>
          )
        }
      </div>
    </div>

    <DerniereMiseAJour date={fiche.misAJour} />

    <section class="candidature" aria-labelledby="candidature">
      <h2 id="candidature" class="visuellement-masque">Où en est sa candidature</h2>
      {
        /*
         * Le rail des étapes dit déjà où en est la candidature : le tag n'est
         * affiché ici que pour une candidature close, que le rail ne montre pas.
         */
        fiche.etape.rang === null && <EtapeCandidature etape={fiche.etape} />
      }
      {
        fiche.etape.rang !== null && (
          <EtapesCandidature
            actuel={fiche.etape.rang}
            titre={`Où en est la candidature de ${nom}`}
            titreVisible={false}
          />
        )
      }
      <p class="statut">
        {fiche.etape.long}, attestée le{" "}
        <time datetime={candidature.statutDepuis}>{formatDateFr(candidature.statutDepuis)}</time>
        {
          fiche.statutSources.map((source, index) => (
            <>
              {index === 0 ? " par " : " et "}
              <a href={source.url} rel="noreferrer">
                {source.titre}
              </a>{" "}
              ({source.media})
            </>
          ))
        }.
      </p>
      {
        fiche.reserve && (
          <p class="reserve-candidature">
            <strong>Réserve :</strong> {fiche.reserve.texte}{" "}
            {fiche.reserve.sources.map((source) => (
              <>
                (
                <a href={source.url} rel="noreferrer">
                  {source.media}
                </a>
                ,{" "}
                <time datetime={source.dateDeclaration}>
                  {formatDateFr(source.dateDeclaration)}
                </time>
                )
              </>
            ))}
          </p>
        )
      }
    </section>

    <dl class="chiffres">
      <div>
        <dt>Programme</dt>
        <dd>{fiche.programme.court}</dd>
      </div>
      <div>
        <dt>Propositions relevées</dt>
        <dd>{fiche.nombrePropositions}</dd>
      </div>
      <div>
        <dt>Positions du test</dt>
        <dd>{fiche.documentees} sur {NOMBRE_AFFIRMATIONS}</dd>
      </div>
    </dl>
  </Fragment>

  <section aria-labelledby="programme">
    <h2 id="programme">Son programme</h2>
    <p class="etat-programme">
      <strong>{fiche.programme.libelle}.</strong>{" "}
      {fiche.programme.texte}{" "}
      <span class="source-etat">
        Source :{" "}
        {
          fiche.programme.sources.map((source, index) => (
            <>
              {index > 0 && " ; "}
              <a href={source.url} rel="noreferrer">
                {source.titre}
              </a>
              {`, ${source.media}`}
            </>
          ))
        }.
      </span>
    </p>

    {
      fiche.nombrePropositions === 0 ? (
        <p>
          Aucune proposition de {nom} n'est relevée à ce jour. Rien n'est attribué sans source
          publique : cette section se remplira quand un programme, une déclaration ou un document de
          son parti permettra de citer une mesure.
        </p>
      ) : (
        <>
          <p class="rappel">
            Ces propositions décrivent un programme. Elles n'entrent pas dans le calcul du test, qui
            ne compare que les {NOMBRE_AFFIRMATIONS} affirmations de la section suivante. Chacune
            porte la nature du document d'où elle vient : un programme 2027 n'engage pas comme une
            proposition de loi ou un texte du parti.
          </p>
          {fiche.mesures.map((groupe) => (
            <section class="domaine" aria-labelledby={`domaine-${groupe.domaine}`}>
              <h3 id={`domaine-${groupe.domaine}`}>{groupe.libelle}</h3>
              <div class="propositions">
                {groupe.propositions.map((proposition) => (
                  <Proposition proposition={proposition} />
                ))}
              </div>
            </section>
          ))}
          {fiche.orientations.length > 0 && (
            <section class="domaine" aria-labelledby="orientations">
              <h3 id="orientations">Grandes orientations</h3>
              <p class="rappel">
                Des axes revendiqués, sans mesure précise à ce stade : ils disent où va la campagne,
                pas ce qu'elle ferait.
              </p>
              <div class="propositions">
                {fiche.orientations.map((proposition) => (
                  <Proposition proposition={proposition} />
                ))}
              </div>
            </section>
          )}
        </>
      )
    }
  </section>

  <section aria-labelledby="positions">
    <h2 id="positions">Ses positions sur le test</h2>
    {
      fiche.documentees === 0 ? (
        <p>
          Aucune position de {nom} n'est documentée à ce jour sur les {NOMBRE_AFFIRMATIONS}{" "}
          affirmations du test. Rien n'est attribué sans source publique : cette section se remplira
          quand des déclarations, un programme ou la plateforme d'un parti permettront de coder une
          position.
        </p>
      ) : (
        <>
          <p>
            Position documentée sur {fiche.documentees} des {NOMBRE_AFFIRMATIONS} affirmations du
            test :
          </p>
          <ul class="decompte">
            {decompte.map((ligne, index) => (
              <li>{`${ligne}${index === decompte.length - 1 ? "." : " ;"}`}</li>
            ))}
          </ul>
          <ul class="bilan" aria-label="Bilan des positions">
            {bilan.map((ligne) => (
              <li>
                <MarquePosition sens={ligne.sens} taille="grande" />
                <span class="bilan-nombre">{ligne.nombre}</span>
                <span class="bilan-libelle">{LIBELLES_SENS[ligne.sens]}</span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <p>
      Pour comparer ces positions aux vôtres, <a href="/test">faites le test</a> : {
        NOMBRE_AFFIRMATIONS
      } affirmations, et un calcul qui reste dans votre navigateur.
    </p>

    {
      fiche.parTheme.map((groupe) => (
        <section class="theme" aria-labelledby={groupe.theme.slug}>
          {/*
           * Le thème d'abord : un bandeau à sa teinte, comme sur /themes. C'est
           * le repère qu'on cherche en défilant, pas le verdict d'une ligne.
           */}
          <header class={`theme-tete t-${groupe.theme.teinte}`}>
            <span class="theme-pictogramme" aria-hidden="true">
              <Icone nom={groupe.theme.icone} graisse="fill" />
            </span>
            <h3 id={groupe.theme.slug}>{groupe.theme.nom}</h3>
            <a class="vers-theme" href={`/themes/${groupe.theme.slug}`}>
              Tous les candidats<span class="visuellement-masque"> sur ce thème</span>
            </a>
          </header>
          {groupe.entrees.map((entree) => {
            const { position, heriteDe } = entree.resolue!;
            const sens = sensDe(position.value);
            return (
              /*
               * UNE LIGNE PAR QUESTION, QUI SE DÉPLIE (27 septembre 2026).
               * En surface : la pastille, la QUESTION en gras, puis le
               * verdict en petit — c'est la question qu'on lit en défilant.
               * Au dépli : l'échelle, l'origine, la citation, les sources.
               * `<details>` natif : le contenu replié est dans le HTML servi,
               * lu par les robots, et s'ouvre au clavier sans script. Le
               * script en bas de page ne fait qu'ouvrir la ligne visée par
               * une ancre venue d'une page de thème.
               */
              <details class={`position position--${sens}`} id={entree.question.id}>
                <summary>
                  <MarquePosition sens={sens} taille="grande" />
                  <span class="position-tete">
                    <h4>{entree.question.texte}</h4>
                    <span class="position-verdict">
                      <strong>{verdict(position.value)}</strong>
                      {heriteDe !== null && <span> · reprise : {heriteDe}</span>}
                    </span>
                  </span>
                  <span class="deplier" aria-hidden="true">
                    <Icone nom="caret-down" graisse="bold" />
                  </span>
                </summary>
                <div class="position-detail">
                  {/*
                   * L'échelle du test, cinq crans du plein accord au plein
                   * désaccord, dans l'ordre où le test les pose. Le cran
                   * retenu prend la couleur du sens : même traitement pour
                   * tous les candidats.
                   */}
                  <p class="echelle-ligne">
                    <span class="echelle" aria-hidden="true">
                      {ECHELLE.map((cran) => (
                        <span
                          class:list={["echelon", { retenu: cran.valeur === position.value }]}
                        />
                      ))}
                    </span>
                    <span>Position retenue : {LIBELLE_VALEUR.get(position.value)}</span>
                  </p>
                  {/*
                   * Les espaces explicites entre les lignes ne se voient pas à
                   * l'écran, où chacune est un bloc. Ils comptent pour le texte
                   * brut : sans eux, un robot ou un mode lecture lit
                   * « Déclaration directe.La citation… ».
                   */}
                  <p class="ligne">
                    <span>Origine : {entree.origine}.</span>{" "}
                    {heriteDe !== null && (
                      <>
                        <span class="heritage">
                          Position de {heriteDe}, reprise faute de déclaration personnelle de {nom}.
                        </span>{" "}
                      </>
                    )}
                    <span>{LIBELLES_ADEQUATION[position.adequation]}</span>{" "}
                    <span>{LIBELLES_CONFIANCE[position.confidence]}</span>
                  </p>
                  {position.citation && (
                    <blockquote class="citation">« {position.citation} »</blockquote>
                  )}
                  {/*
                   * Une inférence n'a pas de verbatim : son raisonnement est la
                   * seule chose qui la rende contestable, et le schéma l'exige
                   * complet. Il est donc publié, et seulement pour elle.
                   */}
                  {position.provenance === "inference" && (
                    <p class="raisonnement">Raisonnement de l'éditeur : {position.rationale}</p>
                  )}
                  {position.sourcePrimaire && (
                    <p class="ligne">Propos d'origine : {position.sourcePrimaire}.</p>
                  )}
                  {entree.dateAncienne !== null && (
                    <p class="ancienne">
                      Position tirée d'un document du {formatDateFr(entree.dateAncienne)}, antérieur
                      à la campagne de 2027. Elle peut avoir changé depuis. Ce codage est provisoire
                      : il sera remplacé dès la publication du programme présidentiel de cet acteur.
                    </p>
                  )}
                  <ul class="sources">
                    {entree.sources.map((source) => (
                      <li>
                        <a href={source.url} rel="noreferrer">
                          {source.titre}
                        </a>
                        {`, ${source.media}, `}
                        <time datetime={source.dateDeclaration}>
                          {formatDateFr(source.dateDeclaration)}
                        </time>
                      </li>
                    ))}
                  </ul>
                  <p class="mise-a-jour">
                    Codage mis à jour le{" "}
                    <time datetime={position.updatedAt}>{formatDateFr(position.updatedAt)}</time>
                  </p>
                </div>
              </details>
            );
          })}
        </section>
      ))
    }
  </section>

  {
    fiche.inconnues.length > 0 && (
      <section aria-labelledby="sans-position">
        <h2 id="sans-position">Sans position documentée</h2>
        <p>
          Aucune source publique lue ne permet, à ce jour, de coder la position de {nom} sur{" "}
          {fiche.inconnues.length > 1 ? "ces affirmations" : "cette affirmation"}. Dans le test,
          elles sont écartées du calcul, pas comptées comme un désaccord.
        </p>
        <ul class="inconnues">
          {fiche.inconnues.map((question) => (
            <li id={question.id}>
              <MarquePosition sens="inconnu" taille="petite" />
              <span>{question.texte}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p class="signature">
    La <a href="/methodologie">méthodologie</a> explique comment une position est établie, ce que signifient
    l'origine, l'adéquation et la confiance, et comment une proposition de programme est relevée. Une
    erreur ? La procédure de signalement est décrite dans la <a href="/charte-editoriale"
      >charte éditoriale</a
    >, et les corrections déjà publiées dans le <a href="/corrections">registre</a>.
  </p>

  <script slot="apres" type="application/ld+json" set:html={JSON.stringify(filAriane)} is:inline />

  <script>
    /*
     * OUVRE LA QUESTION VISÉE PAR UNE ANCRE. Les pages de thème lient chaque
     * visage à `/candidats/{slug}#{question}` ; la question est une ligne
     * repliée, et le lecteur doit tomber sur l'explication, pas sur un titre
     * fermé. Amélioration progressive : sans script, l'ancre mène à la ligne,
     * qu'un clic déplie. Aucune requête, le script ne lit que la page.
     */
    function ouvrirCible() {
      const id = decodeURIComponent(location.hash.slice(1));
      const cible = id ? document.getElementById(id) : null;
      if (cible instanceof HTMLDetailsElement) cible.open = true;
    }
    ouvrirCible();
    window.addEventListener("hashchange", ouvrirCible);
  </script>
  <script slot="apres" type="application/ld+json" set:html={JSON.stringify(personne)} is:inline />
</PageLecture>

<style>
  .identite {
    display: flex;
    align-items: center;
    gap: var(--pas-3);
    margin-bottom: var(--pas-2);
  }

  .identite h1 {
    margin: 0;
  }

  .parti {
    display: flex;
    align-items: center;
    gap: var(--pas-1);
    margin: var(--pas-1) 0 0;
    color: var(--couleur-encre-faible);
  }

  /*
   * Plaque claire, dans les deux thèmes, pour la même raison qu'au résultat :
   * la plupart des logos sont du texte sombre sur fond transparent, et
   * disparaissent sur le fond du thème nuit. C'est la seule couleur en dur de
   * la page, et c'est la même que celle, justifiée, de `.logo` dans
   * `Resultat.svelte`.
   */
  .logo {
    flex: none;
    height: 22px;
    width: auto;
    max-width: 88px;
    object-fit: contain;
    background: #ffffff;
    padding: 2px 3px;
    border: 1px solid var(--couleur-trait);
  }

  .candidature {
    margin: var(--pas-3) 0 0;
  }

  .statut {
    margin: var(--pas-3) 0 0;
    font-size: var(--t-petit);
    color: var(--couleur-encre-faible);
    max-width: var(--mesure);
  }

  /* En pleine encre et bordée : une réserve se lit avant la suite de la fiche. */
  .reserve-candidature {
    margin: var(--pas-2) 0 0;
    padding-left: var(--pas-2);
    border-left: 2px solid var(--couleur-encre-faible);
    font-size: var(--t-petit);
    max-width: var(--mesure);
  }

  .chiffres {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--pas-3);
    margin: var(--pas-4) 0 0;
    padding: var(--pas-3) 0;
    border-block: 1px solid var(--couleur-trait);
  }

  .chiffres dt {
    font-size: 0.8125rem;
    color: var(--couleur-encre-faible);
  }

  .chiffres dd {
    margin: 4px 0 0;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }

  .etat-programme {
    max-width: var(--mesure);
  }

  .source-etat {
    display: block;
    margin-top: var(--pas-1);
    font-size: var(--t-petit);
    color: var(--couleur-encre-faible);
  }

  .rappel {
    color: var(--couleur-encre-faible);
    font-size: var(--t-petit);
  }

  .domaine {
    margin-top: var(--pas-5);
  }

  .domaine h3 {
    margin: 0 0 var(--pas-2);
  }

  /*
   * Bandeau de thème : pictogramme, nom, lien vers la page du thème. Il est à
   * la teinte du thème, comme les tuiles de /themes : c'est le repère qu'on
   * cherche en défilant.
   */
  .theme-tete {
    display: grid;
    grid-template-columns: auto 1fr;
