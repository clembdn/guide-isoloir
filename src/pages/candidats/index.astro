---
/*
 * Liste des candidats suivis : un trombinoscope.
 *
 * REFAITE LE 27 SEPTEMBRE 2026. L'ancienne liste montrait un portrait de
 * 64 px, trois étiquettes grises et un aperçu déplié, vingt-huit fois de
 * suite : près de dix mille pixels de haut sur un téléphone, et rien qui
 * ressemble aux pages de thème. Chaque candidat est désormais une carte à
 * grand portrait — deux par ligne à 375 px, trois puis quatre sur ordinateur —
 * avec son parti, l'étape de sa candidature et le même bilan ✓ / ✗ / ? que
 * sa fiche. Le programme détaillé et l'aperçu des propositions vivent sur la
 * fiche ; la carte y mène tout entière.
 *
 * ORDRE ALPHABÉTIQUE PAR `sortName`, jamais par couverture ni par notoriété :
 * c'est la règle publiée sur `/charte-editoriale`. Ni l'étape, ni le nombre de
 * propositions, ni le bilan ne décident de l'ordre : ils s'affichent, ils ne
 * trient pas.
 *
 * MÊME CARTE POUR TOUS : même cadre, même taille de portrait, mêmes lignes.
 * Un candidat sans photo libre a ses initiales, au même format. Le bilan est
 * affiché pour tous, zéro compris : une carte sans position connue le dit.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import DerniereMiseAJour from "../../components/DerniereMiseAJour.astro";
import Portrait from "../../components/candidats/Portrait.astro";
import EtapeCandidature from "../../components/candidats/EtapeCandidature.astro";
import EtapesCandidature from "../../components/schemas/EtapesCandidature.astro";
import MarquePosition from "../../components/themes/MarquePosition.astro";
import Icone from "../../components/Icone.astro";
import { fiches, NOMBRE_AFFIRMATIONS } from "../../lib/fiches";
import { CRANS_CANDIDATURE, LEGENDE_ETAPES } from "../../lib/libelles";
import { SITE_NAME, SITE_URL, ELECTION } from "../../lib/site";
import { formatDateFr } from "../../lib/date";

const toutes = fiches();

/*
 * Un candidat retiré garde sa fiche et reste listé, mais à part : le mêler aux
 * candidatures en cours laisserait croire qu'il est toujours en lice.
 */
const RETRAITS = new Set(["withdrawn", "eliminated"]);
const enLice = toutes.filter((fiche) => !RETRAITS.has(fiche.candidature.status));
const retirees = toutes.filter((fiche) => RETRAITS.has(fiche.candidature.status));

/** La liste change quand une fiche change : sa date est celle de la plus récente. */
const UPDATED = toutes.map((fiche) => fiche.misAJour).reduce((a, b) => (a > b ? a : b));

/*
 * Combien de candidatures à chaque étape. Un compte, pas un classement : il
 * dit où en est la campagne, pas qui a le plus de chances.
 */
const parEtape = LEGENDE_ETAPES.map((etape) => ({
  ...etape,
  nombre: enLice.filter((fiche) => fiche.etape.rang === etape.rang).length,
}));
const crans = Array.from({ length: CRANS_CANDIDATURE }, (_, index) => index + 1);

function accorder(nombre: number, singulier: string, pluriel: string): string {
  return `${nombre} ${nombre > 1 ? pluriel : singulier}`;
}

const filAriane = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    {
      "@type": "ListItem",
      position: 2,
      name: "Candidats",
      item: new URL("/candidats", SITE_URL).href,
    },
  ],
};

const liste = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Candidats suivis pour l'élection présidentielle 2027",
  numberOfItems: enLice.length,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: enLice.map((fiche, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: fiche.acteur.name,
    url: new URL(`/candidats/${fiche.acteur.slug}`, SITE_URL).href,
  })),
};
---

<BaseLayout
  title="Candidats à l'élection présidentielle 2027"
  description={`Les ${enLice.length} personnes suivies pour l'élection présidentielle de 2027, par ordre alphabétique. Pour chacune : où en est sa candidature, ce que l'on sait de son programme, et ses positions sur les ${NOMBRE_AFFIRMATIONS} affirmations du test, avec leurs sources.`}
  updated={UPDATED}
  gabarit="libre"
  webPage={{ "@type": "CollectionPage" }}
>
  <div class="enveloppe-large page-candidats">
    <nav class="fil-ariane" aria-label="Fil d'Ariane">
      <a href="/">{SITE_NAME}</a>
    </nav>

    <header class="tete">
      <h1>Les candidats à la présidentielle 2027</h1>
      <p class="chapo">
        {enLice.length} personnes suivies pour les scrutins du {formatDateFr(ELECTION.round1)} et du{
          " "
        }
        {formatDateFr(ELECTION.round2)}, par ordre alphabétique. L'ordre n'exprime aucune
        préférence.
      </p>
      <DerniereMiseAJour date={UPDATED} />
    </header>

    <section class="etapes" aria-labelledby="etapes-titre">
      <h2 id="etapes-titre">Où en sont les candidatures</h2>
      <ol class="etapes-comptes">
        {
          parEtape.map((etape) => (
            <li>
              <span class="crans" aria-hidden="true">
                {crans.map((cran) => (
                  <span class:list={["cran", { plein: cran <= etape.rang }]} />
                ))}
              </span>
              <span class="etape-nombre">{etape.nombre}</span>
              <span class="etape-libelle">{etape.court}</span>
            </li>
          ))
        }
      </ol>
      <details class="etapes-detail">
        <summary>
          <Icone nom="caret-right" graisse="bold" class="chevron" />
          Ce que veut dire chaque étape
        </summary>
        <EtapesCandidature titre="Les quatre étapes d'une candidature" titreVisible={false} />
      </details>
    </section>

    <h2 class="visuellement-masque" id="liste">Les candidatures en cours</h2>
    <ul class="trombinoscope" aria-labelledby="liste">
      {
        enLice.map((fiche) => (
          <li class="candidat">
            <Portrait nom={fiche.acteur.name} chemin={fiche.portrait} taille="carte" />
            <div class="corps">
              <h3 class="nom">
                <a href={`/candidats/${fiche.acteur.slug}`}>{fiche.acteur.name}</a>
              </h3>
              <p class="parti">{fiche.parti ? fiche.parti.nom : "Sans parti rattaché"}</p>
              <EtapeCandidature etape={fiche.etape} reserve={fiche.reserve !== null} />
              <div class="pied-carte">
                <ul class="bilan" aria-hidden="true">
                  <li>
                    <MarquePosition sens="pour" taille="petite" />
                    {fiche.bilan.pour}
                  </li>
                  <li>
                    <MarquePosition sens="contre" taille="petite" />
                    {fiche.bilan.contre}
                  </li>
                  <li>
                    <MarquePosition sens="inconnu" taille="petite" />
                    {fiche.bilan.inconnu}
                  </li>
                </ul>
                <p class="visuellement-masque">
                  {`Sur les ${NOMBRE_AFFIRMATIONS} affirmations du test : ${fiche.bilan.pour} pour, ${fiche.bilan.contre} contre${fiche.bilan.neutre > 0 ? `, ${fiche.bilan.neutre} ni pour ni contre` : ""}, ${fiche.bilan.inconnu} sans position connue.`}
                </p>
                <p class="programme">
                  {fiche.programme.libelle}
                  {fiche.nombrePropositions > 0 &&
                    `, ${accorder(fiche.nombrePropositions, "proposition", "propositions")}`}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    {
      retirees.length > 0 && (
        <section aria-labelledby="retraits" class="retraits">
          <h2 id="retraits">Candidatures retirées ou éliminées</h2>
          <p>Leurs fiches restent en ligne, avec leur statut et l'historique de leurs positions.</p>
          <ul class="retraits-liste">
            {retirees.map((fiche) => (
              <li>
                <a href={`/candidats/${fiche.acteur.slug}`}>
                  <Portrait nom={fiche.acteur.name} chemin={fiche.portrait} taille={40} />
                  <span>
                    <strong>{fiche.acteur.name}</strong>
                    <span class="retrait-statut">{fiche.etape.long}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="appel" aria-labelledby="appel-titre">
      <h2 id="appel-titre">De qui êtes-vous le plus proche ?</h2>
      <p>
        Répondez aux {NOMBRE_AFFIRMATIONS} questions du test : le calcul reste dans votre navigateur.
      </p>
      <a class="action action--grand" href="/test">Commencer le test</a>
    </section>

    <div class="regles">
      <p>
        Une personne entre dans cette liste sur un acte public et daté : une déclaration de
        candidature, une candidature à une primaire, ou une désignation par son parti. Ni un sondage
        ni une rumeur de presse ne suffisent. L'étape affichée découle de cet acte, pas d'une
        appréciation. Les règles sont décrites dans la <a href="/charte-editoriale"
          >charte éditoriale</a
        >.
      </p>
      <p>
        Les pastilles comptent les positions de chaque candidat sur les {NOMBRE_AFFIRMATIONS} affirmations
        du test : pour, contre, et sans position connue. Leur nombre dépend de ce que chaque campagne
        a déclaré ou publié, pas de la qualité d'un programme. La <a href="/methodologie"
          >méthodologie</a
        > explique comment une position est établie.
      </p>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(filAriane)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(liste)} is:inline />
</BaseLayout>

<style>
  .page-candidats {
    padding-block: var(--pas-4) var(--pas-6);
  }

  .tete {
    max-width: 44rem;
  }

  .tete h1 {
    margin-top: var(--pas-2);
    text-wrap: balance;
  }

  .chapo {
    font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.3125rem);
    margin: var(--pas-2) 0 var(--pas-1);
    text-wrap: pretty;
  }

  /*
   * ÉTAPES : QUATRE COMPTES, PAS UNE LÉGENDE. On voit d'un coup d'œil où en
   * est la campagne ; l'explication de chaque étape est repliée dessous,
   * présente dans le HTML servi. Même panneau que le bilan de la fiche :
   * filets d'un pixel peints par le fond de la liste.
   */
  .etapes {
    margin-block: var(--pas-5);
  }

  .etapes h2 {
    font-size: var(--t-h3);
    margin: 0 0 var(--pas-2);
  }

  .etapes-comptes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--couleur-trait);
    border: 1px solid var(--couleur-trait);
    border-radius: var(--rayon-carte);
    overflow: clip;
  }

  @media (min-width: 48rem) {
    .etapes-comptes {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .etapes-comptes li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    margin: 0;
    padding: var(--pas-3);
    background: var(--couleur-surface);
  }

  .crans {
    display: inline-grid;
    grid-template-columns: repeat(4, 1rem);
    gap: 3px;
  }

  .cran {
    height: 5px;
    background: var(--couleur-trait);
  }

  .cran.plein {
    background: var(--couleur-signature);
  }

  .etape-nombre {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .etape-libelle {
    font-size: var(--t-petit);
    line-height: 1.3;
    color: var(--couleur-encre-faible);
  }

  .etapes-detail {
    margin-top: var(--pas-2);
  }

  .etapes-detail summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    cursor: pointer;
    font-size: var(--t-petit);
    font-weight: 600;
    color: var(--couleur-signature);
    list-style: none;
  }

  .etapes-detail summary::-webkit-details-marker {
    display: none;
  }

  .etapes-detail :global(.chevron) {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform var(--duree) var(--sortie);
  }

  .etapes-detail[open] :global(.chevron) {
    transform: rotate(90deg);
  }

  /*
   * TROMBINOSCOPE. Deux cartes par ligne à 375 px, trois à 48 rem, quatre à
   * 64 rem. Toutes identiques : même portrait carré, mêmes lignes, et le pied
   * de carte collé en bas pour que les bilans s'alignent d'une carte à
   * l'autre, quelle que soit la longueur d'un nom ou d'un parti.
   */
  .trombinoscope {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--pas-2);
  }

  @media (min-width: 48rem) {
    .trombinoscope {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--pas-3);
    }
  }

  @media (min-width: 64rem) {
    .trombinoscope {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .candidat {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 0;
    background: var(--couleur-surface);
    border: 1px solid var(--couleur-trait);
    border-radius: var(--rayon-carte-l);
    overflow: clip;
    transition:
      transform var(--duree) var(--sortie),
      box-shadow var(--duree) var(--sortie);
  }

  /* Sans photo libre, les initiales sur le fond secondaire : même carré, même place. */
  .candidat :global(.portrait-absent) {
    background: var(--couleur-surface-2);
  }

  /* Le portrait ne bouge pas au survol : c'est la carte qui se soulève, pas l'image. */
  .candidat :global(.portrait) {
    border: 0;
    border-bottom: 1px solid var(--couleur-trait);
  }

  @media (hover: hover) and (pointer: fine) {
    .candidat:hover {
      transform: translateY(-3px);
      box-shadow: var(--ombre-2);
    }

    .candidat:hover .nom a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .candidat:active {
    transform: scale(0.985);
  }

  .candidat:has(.nom a:focus-visible) {
    outline: 2px solid var(--couleur-signature);
    outline-offset: 3px;
  }

  .corps {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: var(--pas-2) var(--pas-2) var(--pas-3);
  }

  @media (min-width: 48rem) {
    .corps {
      padding: var(--pas-3);
    }
  }

  .nom {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .nom {
      font-size: 1.125rem;
    }
  }

  /* Le lien du nom couvre toute la carte : un seul arrêt de tabulation par candidat. */
  .nom a {
    color: var(--couleur-encre);
    text-decoration: none;
  }

  .nom a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .nom a:focus-visible {
    outline: none;
  }

  .parti {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--couleur-encre-faible);
  }

  /* Quand le libellé passe sous les crans, un interligne les sépare. */
  .candidat :global(.etape) {
    font-size: 0.75rem;
    margin-top: 0.15rem;
    row-gap: 0.3rem;
  }

  .pied-carte {
    margin-top: auto;
    padding-top: var(--pas-2);
    display: grid;
    gap: 0.35rem;
  }

  .bilan {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--pas-2);
    font-size: var(--t-petit);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .bilan li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
  }

  .programme {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--couleur-encre-faible);
  }

  .retraits {
    margin-top: var(--pas-6);
  }

  .retraits h2 {
    font-size: var(--t-h3);
    margin: 0 0 var(--pas-1);
  }

  .retraits-liste {
    list-style: none;
    padding: 0;
    margin: var(--pas-3) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--pas-2);
  }

  .retraits-liste li {
    margin: 0;
  }

  .retraits-liste a {
    display: inline-flex;
    align-items: center;
    gap: var(--pas-2);
    min-height: 44px;
    padding: 0.3rem 1rem 0.3rem 0.3rem;
    border: 1px solid var(--couleur-trait);
    border-radius: var(--rayon-actionnable);
    color: var(--couleur-encre);
    text-decoration: none;
  }

  .retraits-liste :global(.portrait) {
    border-radius: 50%;
  }

  .retraits-liste a > span {
    display: grid;
    line-height: 1.25;
  }

  .retrait-statut {
    font-size: 0.8125rem;
    color: var(--couleur-encre-faible);
  }

  .appel {
    margin-top: var(--pas-6);
    padding: var(--pas-5) var(--pas-3);
    border-radius: var(--rayon-carte-l);
    background: var(--couleur-surface-2);
    text-align: center;
  }

  .appel h2 {
    margin: 0 auto;
    max-width: 22ch;
    text-wrap: balance;
  }

  .appel p {
    margin: var(--pas-2) auto var(--pas-4);
    max-width: 32rem;
  }

  .regles {
    margin-top: var(--pas-5);
    max-width: 44rem;
    font-size: var(--t-petit);
    color: var(--couleur-encre-faible);
  }
</style>
