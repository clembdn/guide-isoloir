---
/*
 * Route du résultat.
 *
 * `noindex, nofollow` est définitif : un résultat indexé serait un problème de
 * confidentialité autant que de neutralité. La page n'est pas bloquée dans
 * robots.txt, sinon aucun robot ne pourrait lire cette directive.
 *
 * AUCUN IDENTIFIANT NE FIGURE JAMAIS DANS CETTE URL. Les réponses transitent par
 * le stockage de session, jamais par l'adresse : une URL de résultat partagée,
 * copiée dans un historique ou envoyée dans un `Referer` exposerait des opinions
 * politiques. `tests/e2e/resultat.spec.ts` le vérifie.
 *
 * NE SERT QUE LES POSITIONS RELUES. `positionsPubliables` écarte `draft` et
 * `double-coded` : un codage qui n'a pas été confronté n'entre pas dans un
 * classement public. Tant qu'aucune position n'est réconciliée, la page le dit
 * au lieu d'afficher un classement de zéros.
 *
 * UNE SEULE EXCEPTION, ET ELLE NE SE DÉPLOIE PAS. Le mode prévisualisation
 * (`GUIDE_ISOLOIR_PREVISUALISATION=1` au build) sert aussi les brouillons, avec
 * un bandeau permanent. Il existe parce qu'un codage qu'on ne peut pas afficher
 * est un codage qu'on ne peut pas relire. `npm run build:prod` ne pose pas le
 * drapeau, et le garde-fou de `dist/` refuse un build où une position `draft`
 * apparaîtrait dans ce qui est servi : deux verrous indépendants, l'oubli d'un
 * seul ne suffit pas à publier un brouillon.
 *
 * Contrainte permanente : aucun script tiers, aucune police distante, aucun
 * analytics sur cette route.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Resultat from "../components/Resultat.svelte";
import { validerQuestions, validerSourcesInfobulles } from "../lib/questions";
import {
  positionsPubliables,
  validerActeurs,
  validerCandidatures,
  validerPositions,
  validerSourcesPositions,
} from "../lib/acteurs";
import { QUESTIONS, SOURCES_INFOBULLES } from "../data/questions";
import { ACTEURS, CANDIDATURES } from "../data/acteurs";
import { POSITIONS } from "../data/positions";
import { SOURCES_POSITIONS } from "../data/sources-positions";
import { projeter } from "../lib/projection";
import {
  BANDEAU_PREVISUALISATION,
  PREVISUALISATION,
  positionsServies,
} from "../lib/previsualisation";
import { SEUIL_PUBLICATION, seuilDepuisEnvironnement } from "../lib/seuils";
import { media } from "../data/medias";
import { partiDe } from "../lib/fiches";

/*
 * Validation au build, côté serveur uniquement. Elle est référentielle : une
 * position rattachée à un acteur, une question ou une source qui n'existe pas
 * arrête la construction, comme une candidature qui reprendrait la ligne d'un
 * acteur inconnu.
 */
const questionsValidees = validerQuestions(QUESTIONS);
validerSourcesInfobulles(SOURCES_INFOBULLES, questionsValidees);

const acteurs = validerActeurs(ACTEURS);
const candidatures = validerCandidatures(CANDIDATURES, acteurs);
const sources = validerSourcesPositions(SOURCES_POSITIONS);
const positions = validerPositions(POSITIONS, { acteurs, questions: questionsValidees, sources });

/*
 * Seuls les candidats sont CLASSÉS. Les partis, eux, sont passés en `annuaire` :
 * ils portent les positions reprises et doivent pouvoir être nommés, sans
 * occuper pour autant une ligne du classement. Les classer ajouterait vingt
 * lignes que personne n'a demandé à comparer ; ne pas les transmettre du tout
 * ferait afficher « parti-rassemblement-national » à la place du nom sous
 * chaque position héritée.
 */
const candidats = acteurs.filter((acteur) => acteur.kind === "candidate");
const servies = positionsServies(positions);
const nonRelues = positions.length - positionsPubliables(positions).length;

const questions = projeter(QUESTIONS);

/*
 * Portraits et logos, résolus ICI et passés en propriété.
 *
 * `src/data/medias.ts` porte trente-cinq entrées avec leur auteur, leur licence
 * et l'URL de cette licence : de quoi rendre `/credits-images` exact, et rien
 * qui ait à voyager dans le bundle d'une route budgétée à 20 ko. L'îlot ne
 * reçoit donc que trois chemins par candidat.
 *
 * Le parti d'un candidat est le premier acteur de type `party` de sa chaîne de
 * reprise : voir `partiDe`, partagé avec les fiches candidat.
 */
const nomParActeur = new Map(acteurs.map((acteur) => [acteur.id, acteur.name]));

const visuels = candidats.map((candidat) => {
  const partiId = partiDe(
    candidatures.find((c) => c.actorId === candidat.id),
    acteurs,
  );
  return {
    actorId: candidat.id,
    portrait: media("portrait", candidat.id)?.chemin ?? null,
    logo: partiId === null ? null : (media("logo", partiId)?.chemin ?? null),
    parti: partiId === null ? null : (nomParActeur.get(partiId) ?? null),
  };
});

/*
 * Seuil de publication, résolu ICI et passé en propriété.
 *
 * Il se règle sans recompiler un composant, parce que c'est une décision
 * éditoriale et pas une constante de code. La lecture se fait côté Node : les
 * îlots reçoivent des nombres, jamais `process`.
 */
const seuilCouverture = seuilDepuisEnvironnement(
  "GUIDE_ISOLOIR_SEUIL_COUVERTURE",
  SEUIL_PUBLICATION.couverture,
);
const seuilActeursMin = seuilDepuisEnvironnement(
  "GUIDE_ISOLOIR_SEUIL_ACTEURS",
  SEUIL_PUBLICATION.acteursMin,
);
---

<BaseLayout
  title="Votre résultat"
  description="Résultat du test comparatif de Guide Isoloir, calculé dans votre navigateur."
  noindex={true}
  actionEntete={false}
>
  <h1>Votre résultat</h1>

  {
    /*
     * Le bandeau est rendu ICI, en HTML statique, et non seulement dans l'îlot :
     * il doit être lu avant l'hydratation, et rester lisible si le JavaScript
     * échoue. Un avertissement qui dépend du script qu'il avertit ne protège
     * personne.
     */
    PREVISUALISATION && <p class="bandeau-previsualisation">{BANDEAU_PREVISUALISATION}</p>
  }

  <p>
    Ce résultat a été calculé dans votre navigateur, à partir des réponses conservées dans cet
    onglet. Il n'a été ni envoyé, ni enregistré, ni associé à un identifiant.
  </p>

  {
    servies.length === 0 ? (
      <section class="cadre-lecture">
        <h2>Aucune position n'est encore publiée</h2>
        <p>
          {nonRelues} position{nonRelues > 1 ? "s" : ""} sont codées et attendent leur relecture.
          Aucune n'est servie tant qu'elle n'a pas été confrontée : un classement établi sur des
          codages non relus ressemblerait trait pour trait à un classement fiable, et rien ne l'en
          distinguerait à l'œil.
        </p>
        <p>
          La <a href="/methodologie">méthodologie</a> décrit comment une position est établie, et le
          dépôt public permet de lire chaque codage avec sa source avant qu'il soit publié.
        </p>
      </section>
    ) : (
      /*
       * `avertissement=""` : le bandeau de prévisualisation est rendu en HTML
       * statique plus haut, pas ici. Le passer AUSSI à l'îlot l'affichait deux
       * fois. Le rendu statique est celui qu'on garde, parce qu'il se lit avant
       * l'hydratation et survit à une panne de JavaScript.
       */
      <Resultat
        client:load
        questions={questions}
        acteurs={candidats}
        annuaire={acteurs}
        positions={servies}
        candidatures={candidatures}
        sources={sources}
        visuels={visuels}
        seuilCouverture={seuilCouverture}
        seuilActeursMin={seuilActeursMin}
        avertissement=""
      />
    )
  }

  <noscript>
    <p class="reserve">
      Le calcul se fait dans votre navigateur, et il a besoin de JavaScript. Sans lui, il n'y a rien
      à afficher ici : vos réponses ne sont stockées nulle part ailleurs, et aucun serveur ne peut
      les calculer à votre place.
    </p>
  </noscript>

  <p>
    La <a href="/methodologie">méthodologie</a> explique comment les positions sont établies, ce que le
    calcul fait, et ce qu'il ne fait pas.
  </p>
</BaseLayout>

<style>
  .bandeau-previsualisation {
    border: 2px solid var(--couleur-signature);
    padding: var(--pas-3);
    margin-bottom: var(--pas-4);
    font-size: var(--t-petit);
    font-weight: 600;
  }
</style>
