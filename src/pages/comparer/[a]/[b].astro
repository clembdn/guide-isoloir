---
/*
 * Face-à-face : deux candidats, leurs positions sur chacune des affirmations
 * du test, et ce qu'on peut en dire en chiffres.
 *
 * ELLE RÉPOND À « QUELLE DIFFÉRENCE ENTRE X ET Y ? », pas à « que pense X ? »
 * — c'est la fiche — ni à « qui pense quoi sur Z ? » — c'est la page de thème.
 * Aucune citation n'est donc recopiée : chaque position renvoie, par une
 * ancre, à la ligne de la fiche où se lisent le verbatim, l'origine et la
 * source. Deux pages au contenu identique se feraient concurrence dans les
 * moteurs, et le cahier des charges l'interdit.
 *
 * QUELLES PAIRES. Une règle mécanique, dans `src/lib/face-a-face.ts` et sur
 * `/methodologie` : au moins `COMPARABLES_MIN` affirmations où les deux
 * positions sont connues et tirées de documents distincts. La page est hors
 * index quand l'un des deux n'a aucune position en propre : elle compare alors
 * surtout la ligne d'un parti, et elle le dit.
 *
 * L'ADRESSE EST CANONIQUE : l'ordre alphabétique des fiches. La paire inversée
 * redirige en 301 (`dist/_redirects`, écrit au build).
 *
 * TOUT EST DANS LE HTML SERVI, AUCUN SCRIPT. Les chiffres, la phrase « En
 * bref », les verdicts et les liens se lisent sans JavaScript, y compris par
 * les robots d'IA qui n'en exécutent pas. Le seul mouvement — le trait qui
 * s'ouvre — est en CSS, et la page se lit juste sans lui.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EnTetePaire from "../../../components/comparer/EnTetePaire.astro";
import CoupDOeil from "../../../components/comparer/CoupDOeil.astro";
import EnBref from "../../../components/comparer/EnBref.astro";
import LignePartage from "../../../components/comparer/LignePartage.astro";
import SoliditePaire from "../../../components/comparer/SoliditePaire.astro";
import DansLeChamp from "../../../components/comparer/DansLeChamp.astro";
import PapillonPropositions from "../../../components/comparer/PapillonPropositions.astro";
import Icone from "../../../components/Icone.astro";
import { faceAFace, paires } from "../../../lib/face-a-face";
import { NOMBRE_AFFIRMATIONS } from "../../../lib/fiches";
import { SITE_NAME, SITE_URL } from "../../../lib/site";

export function getStaticPaths() {
  return paires().map((paire) => ({ params: { a: paire.a.slug, b: paire.b.slug } }));
}

const { a: slugA, b: slugB } = Astro.params;
const ff = faceAFace(slugA!, slugB!);

const url = new URL(ff.chemin, SITE_URL).href;

const filAriane = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    {
      "@type": "ListItem",
      position: 2,
      name: "Comparer",
      item: new URL("/comparer", SITE_URL).href,
    },
    { "@type": "ListItem", position: 3, name: `${ff.a.nom} et ${ff.b.nom}`, item: url },
  ],
};

/*
 * Le sujet de la page — deux personnes — et la table brute dont elle est
 * tirée : un assistant qui veut vérifier une position sait où la trouver.
 */
const webPage = {
  about: [ff.a, ff.b].map((visage) => ({
    "@type": "Person",
    name: visage.nom,
    url: new URL(`/candidats/${visage.slug}`, SITE_URL).href,
  })),
  isBasedOn: new URL("/donnees/positions-retenues.csv", SITE_URL).href,
};

const chapoAffirmations = `Chaque visage est posé sur sa réponse, sur l'échelle du test ; le trait qui les relie mesure l'écart. Le nom mène à la citation et à la source, sur la fiche.`;
---

<BaseLayout
  title={ff.titre}
  description={ff.description}
  updated={ff.misAJour}
  gabarit="libre"
  noindex={!ff.indexable}
  webPage={webPage}
>
  <EnTetePaire ff={ff} />

  <div class="enveloppe-large corps">
    <div class="ouverture">
      <CoupDOeil parTheme={ff.parTheme} compte={ff.compte} total={NOMBRE_AFFIRMATIONS} />
      <EnBref enBref={ff.enBref} ecarts={ff.ecarts} rejoignent={ff.rejoignent} />
    </div>

    <section class="section-page" id="affirmations" aria-labelledby="affirmations-titre">
      <h2 id="affirmations-titre">Affirmation par affirmation</h2>
      <p class="chapo-section">{chapoAffirmations}</p>

      {
        ff.parTheme.map((theme) => (
          <section class="theme" aria-labelledby={theme.theme.slug}>
            {/*
             * Le thème d'abord, à sa teinte, comme sur la fiche : c'est le
             * repère qu'on cherche en défilant. La teinte s'arrête au bandeau.
             */}
            <header class={`theme-tete t-${theme.theme.teinte}`}>
              <span class="theme-pictogramme" aria-hidden="true">
                <Icone nom={theme.theme.icone} graisse="fill" />
              </span>
              <h3 id={theme.theme.slug}>{theme.theme.nom}</h3>
              <a class="vers-theme" href={`/themes/${theme.theme.slug}`}>
                Tous les candidats<span class="visuellement-masque"> sur ce thème</span>
              </a>
            </header>
            <ol class="lignes">
              {theme.lignes.map((ligne) => (
                <LignePartage ligne={ligne} a={ff.a} b={ff.b} />
              ))}
            </ol>
          </section>
        ))
      }
    </section>

    <div class="section-page">
      <SoliditePaire
        cotes={[
          { visage: ff.a, solidite: ff.solidite.a },
          { visage: ff.b, solidite: ff.solidite.b },
        ]}
      />
    </div>

    <div class="section-page">
      <DansLeChamp
        cotes={[
          { visage: ff.a, autre: ff.b, champ: ff.champ.a },
          { visage: ff.b, autre: ff.a, champ: ff.champ.b },
        ]}
      />
    </div>

    {
      ff.papillon && (
        <div class="section-page">
          <PapillonPropositions
            domaines={ff.papillon}
            maximum={ff.maximumPapillon}
            a={ff.a}
            b={ff.b}
          />
        </div>
      )
    }

    <section class="appel" aria-labelledby="appel-titre">
      <h2 id="appel-titre">Et vous, où vous situez-vous ?</h2>
      <p>
        Répondez aux {NOMBRE_AFFIRMATIONS} affirmations du test : le même calcul vous situe par rapport
        à chaque candidat, dans votre navigateur.
      </p>
      <a class="action action--grand" href="/test">Commencer le test</a>
    </section>

    <p class="methode" id="methode">
      Comment une comparaison est établie, et pourquoi certaines paires n'en ont pas encore : la <a
        href="/methodologie#comparer-deux-candidats">méthodologie</a
      >. Une position manquante n'est ni un accord ni un désaccord : elle est tenue hors du calcul.
      Une erreur ? La procédure de signalement est décrite dans la <a href="/charte-editoriale"
        >charte éditoriale</a
      >. <a href="/comparer">Comparer deux autres candidats</a>.
    </p>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(filAriane)} is:inline />
</BaseLayout>

<style>
  .corps {
    padding-block: var(--pas-4) var(--pas-6);
  }

  /*
   * L'ouverture : la grille et la phrase côte à côte sur grand écran, pour que
   * la page n'y soit pas une colonne étroite entre deux marges vides.
   */
  .ouverture {
    display: grid;
    gap: var(--pas-5);
  }

  @media (min-width: 64rem) {
    .ouverture {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--pas-5);
      align-items: start;
    }
  }

  .section-page {
    margin-top: var(--pas-6);
  }

  .section-page > h2 {
    margin: 0 0 var(--pas-2);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
  }

  .chapo-section {
    max-width: var(--mesure);
    font-size: var(--t-petit);
    color: var(--couleur-encre-faible);
  }

  .theme {
    margin-top: var(--pas-4);
  }

  /* Bandeau de thème, repris de la fiche candidat. */
  .theme-tete {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.25rem var(--pas-2);
    padding: var(--pas-2) var(--pas-3) var(--pas-2) var(--pas-2);
    border-radius: var(--rayon-carte);
    background: var(--pastel);
  }

  .theme-tete h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  .theme-pictogramme {
    display: grid;
    place-items: center;
    grid-row: 1 / 3;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: var(--couleur-surface);
    color: var(--vif);
  }

  .theme-pictogramme :global(.icone) {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }

  .vers-theme {
    font-size: var(--t-petit);
    font-weight: 600;
    color: var(--couleur-encre);
  }

  @media (min-width: 30rem) {
    .theme-tete {
      grid-template-columns: auto 1fr auto;
    }

    .theme-pictogramme {
      grid-row: auto;
    }
  }

  .lignes {
    list-style: none;
    padding: 0 var(--pas-1);
    margin: 0;
  }

  .appel {
    margin-top: var(--pas-6);
    padding: var(--pas-5) var(--pas-3);
    border-radius: var(--rayon-carte-l);
    background: var(--couleur-surface-2);
    text-align: center;
  }

  .appel h2 {
    margin: 0 auto;
    max-width: 22ch;
    text-wrap: balance;
  }

  .appel p {
    margin: var(--pas-2) auto var(--pas-4);
    max-width: 32rem;
  }

  .methode {
    margin: var(--pas-5) 0;
    max-width: 44rem;
    font-size: var(--t-petit);
    color: var(--couleur-encre-faible);
  }
</style>
