---
/*
 * Accueil — page d'entrée dans l'élection.
 *
 * Elle emploie le gabarit « libre » : le contenu n'est pas enfermé dans la
 * colonne de lecture, chaque section choisit sa largeur. Les pages de texte
 * gardent le gabarit « colonne », qui reste le défaut.
 *
 * PENSÉE POUR LE TÉLÉPHONE D'ABORD. Les styles de base sont ceux de 375 px ;
 * les media queries AJOUTENT la mise en page large, elles ne la retirent pas.
 *
 * LE MOUVEMENT SUIT LE DÉFILEMENT, EN CSS PUR. `animation-timeline` pilote
 * chaque effet par la position de l'élément dans l'écran : aucun script,
 * aucun écouteur de défilement. Un navigateur qui ne connaît pas la propriété
 * affiche la page immobile, et « réduire les animations » l'immobilise aussi.
 * Seules `transform` et `opacity` bougent.
 *
 * AUCUNE TEINTE DE RUBRIQUE N'APPROCHE UN CONTENU POLITIQUE. Les cinq couleurs
 * ne servent qu'aux articles de /comprendre, qui expliquent comment on vote.
 * Elles ne touchent ni candidat, ni position, ni score.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import CompteARebours from "../components/CompteARebours.astro";
import Icone from "../components/Icone.astro";
import VitrineThemes from "../components/accueil/VitrineThemes.astro";
import VitrineCandidats from "../components/accueil/VitrineCandidats.astro";
import { MISES_A_JOUR } from "../lib/mises-a-jour";
import { SITE_NAME, SITE_URL, SITE_TAGLINE, EDITOR_NAME } from "../lib/site";
import { articlesPublies, TEINTES_RUBRIQUE } from "../lib/comprendre";
import { QUESTIONS } from "../data/questions";
import { illustration } from "../data/illustrations";

const UPDATED = MISES_A_JOUR["/"];
const articles = await articlesPublies();

const scene = illustration("bureau-de-vote");
if (!scene) {
  throw new Error(
    "L'illustration « bureau-de-vote » est absente de src/data/illustrations.ts. " +
      "L'accueil ne se construit pas sans elle plutôt que de servir une image manquante.",
  );
}

/*
 * `themes` se compte plutôt qu'il ne s'écrit : le questionnaire garantit
 * quatre affirmations par thème, mais c'est un invariant d'audit, pas une
 * constante à recopier ici.
 */
const themes = new Set(QUESTIONS.map((question) => question.theme)).size;

/*
 * LE TITRE PORTE L'INTENTION DE RECHERCHE, pas le nom du site : « pour qui voter
 * en 2027 » est ce qu'on tape, et ce qu'on demande à un assistant. La réponse
 * honnête — personne ne peut vous le dire — ouvre la description, parce que
 * c'est elle qu'un assistant doit reprendre avant de renvoyer vers le test.
 */
const TITRE = "Pour qui voter en 2027 ? Test de positionnement";
const DESCRIPTION = `Personne ne peut vous dire pour qui voter. Situez vos idées face aux positions sourcées des candidats en ${QUESTIONS.length} affirmations, puis voyez comment voter.`;

/*
 * La même réponse, dans la page, en HTML statique : un robot qui ne lit pas la
 * méta-description la trouve ici. La phrase courte, en grand, s'allume mot à
 * mot au défilement ; la suite se lit en taille courante. Tout d'un bloc, elle
 * prenait un écran entier sur téléphone.
 */
const MANIFESTE = "Personne ne peut vous dire pour qui voter.";
const MANIFESTE_SUITE =
  "Ni un site, ni un assistant. Ce test vous aide à vous situer, positions sourcées à l'appui.";
const MOTS_MANIFESTE = MANIFESTE.split(" ");
/* La révélation mot à mot en tient compte en CSS (`--mots`, `nth-child`) : voir le style. */
if (MOTS_MANIFESTE.length !== 8) {
  throw new Error(
    `La phrase manifeste compte ${MOTS_MANIFESTE.length} mots : mettre à jour \`--mots\` ` +
      "et les rangs `.mot:nth-child()` dans le style de l'accueil.",
  );
}

/*
 * La démo du test : la première affirmation de chaque thème, dans l'ordre du
 * questionnaire. De vraies affirmations, servies telles quelles — et AUCUNE
 * RÉPONSE COCHÉE. Un site neutre qui répondrait « Plutôt d'accord » dans sa
 * propre vitrine prendrait position ; la démo montre le rythme du test, jamais
 * une opinion.
 */
const DEMO = [...QUESTIONS]
  .sort((a, b) => a.ordre - b.ordre)
  .filter((question, index, liste) => liste.findIndex((q) => q.theme === question.theme) === index);

const ETAPES = [
  {
    titre: `Répondez à ${QUESTIONS.length} affirmations`,
    texte: `Une par écran, sur ${themes} thèmes. Passez celles sur lesquelles vous n'avez pas d'avis.`,
  },
  {
    titre: "Voyez de qui vous êtes proche",
    texte: "Les candidats les plus proches de vos réponses, et vos points d'accord.",
  },
  {
    titre: "Vérifiez chaque position",
    texte: "Chaque position cite sa source et sa date. Rien n'est attribué sans preuve.",
  },
];

/*
 * L'échelle de réponse est réelle et partagée avec le quiz. Elle est recopiée
 * ici plutôt qu'importée de `src/lib/echelle.ts` pour une seule raison : ce
 * module part au navigateur pour le quiz, et l'accueil n'a pas besoin de le
 * charger pour afficher des libellés statiques. Si l'échelle change, l'audit
 * de symétrie le dit, et ce bloc se corrige.
 *
 * La démo n'en écrit que les deux bouts : cinq libellés empilés faisaient de
 * la carte un écran entier sur téléphone.
 */
const ECHELLE_APERCU = [
  "Tout à fait d'accord",
  "Plutôt d'accord",
  "Ni d'accord, ni pas d'accord",
  "Plutôt pas d'accord",
  "Pas du tout d'accord",
];

/** Cinq teintes de rubrique, dans l'ordre de parution des articles. */
const TEINTES = TEINTES_RUBRIQUE;

const PREUVES = [
  {
    icone: "book-open-text",
    titre: "Une méthode publiée avant ses résultats",
    texte:
      "Comment une position est établie, ce que le calcul ne fait pas, et pourquoi certains candidats ne sont pas encore classés.",
    lien: "/methodologie",
    libelle: "Lire la méthodologie",
  },
  {
    icone: "prohibit",
    titre: "Aucune publicité jusqu'après le second tour",
    texte: "Ni bandeau, ni programmatique, ni contenu sponsorisé. Une décision publiée.",
    lien: "/financement",
    libelle: "Comment le site est financé",
  },
  {
    icone: "clock-counter-clockwise",
    titre: "Un registre public des corrections",
    texte: "Rien n'est modifié en silence. Chaque correction est datée et motivée.",
    lien: "/corrections",
    libelle: "Voir le registre",
  },
];

const PLUS_LOIN = [
  { href: "/candidats", libelle: "Les candidats" },
  { href: "/themes", libelle: "Les thèmes" },
  { href: "/comprendre", libelle: "Comment voter" },
];

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: SITE_URL,
  inLanguage: "fr-FR",
  description: SITE_TAGLINE,
  // Pas de `publisher` tant que l'éditeur n'est pas nommé : un balisage
  // `Person` sans nom vaut moins qu'une absence de balisage.
  ...(EDITOR_NAME
    ? {
        publisher: {
          "@type": "Person",
          name: EDITOR_NAME,
          url: new URL("/a-propos", SITE_URL).href,
        },
      }
    : {}),
};

/* Les articles montrés sur l'accueil, dans l'ordre où ils s'affichent. */
const articlesLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Comprendre avant de comparer",
  itemListElement: articles.map((article, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: article.data.titre,
    url: new URL(`/comprendre/${article.id}`, SITE_URL).href,
  })),
};
---

<BaseLayout
  title={TITRE}
  description={DESCRIPTION}
  updated={UPDATED}
  gabarit="libre"
  actionEntete={false}
>
  <section class="hero">
    <div class="enveloppe-large">
      <div class="hero-texte">
        <h1>
          <span class="surtitre">Présidentielle 2027</span>
          Quel candidat me correspond le mieux&nbsp;?
        </h1>
        <div class="hero-appel">
          <p class="hero-sous">
            {QUESTIONS.length} affirmations, une par écran. Anonyme et sans inscription&nbsp;: vos réponses
            ne sont enregistrées nulle part.
          </p>
          <p><a class="action action--grand" href="/test">Commencer le test</a></p>
        </div>
      </div>
    </div>

    {
      /*
       * LA PHOTO EN GRAND. Elle occupe toute la largeur de l'écran, mais n'en
       * montre d'abord que la largeur de la page, arrondie : au défilement,
       * elle s'ouvre jusqu'aux bords. C'est le rideau de l'isoloir, deux fois :
       * à l'arrivée, puis sous le doigt.
       *
       * Le crédit n'est pas posé sur la photo : il figure sur /credits-images,
       * lié depuis le pied de chaque page, avec l'auteur, la licence et les
       * retouches.
       */
    }
    <div class="hero-media">
      <picture>
        <source media="(min-width: 48rem)" srcset={scene.cheminLarge} />
        <img
          src={scene.cheminEtroit}
          alt={scene.alt}
          width={scene.largeurEtroit}
          height={scene.hauteurEtroit}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </section>

  <CompteARebours />

  <section class="section manifeste-section">
    <div class="enveloppe-large">
      <p class="manifeste">
        {
          MOTS_MANIFESTE.map((mot, index) => (
            <>
              <span class="mot">{mot}</span>
              {index < MOTS_MANIFESTE.length - 1 ? " " : ""}
            </>
          ))
        }
      </p>
      <p class="manifeste-suite revele">{MANIFESTE_SUITE}</p>
    </div>
  </section>

  <section class="section fonctionnement-section">
    <div class="enveloppe-large fonctionnement" data-scene-racine>
      <div class="fonctionnement-texte revele">
        <h2>Comment ça marche</h2>
        <ol class="etapes">
          {
            ETAPES.map((etape, index) => (
              <li>
                <span class="etape-numero" aria-hidden="true">
                  {index + 1}
                </span>
                <div>
                  <h3>{etape.titre}</h3>
                  <p>{etape.texte}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="action-large">
          <a class="action action--grand" href="/test">Commencer le test</a>
        </p>
      </div>

      {
        /*
         * LA DÉMO. Une pile de six cartes, une par thème : celle de devant
         * part vers la gauche, la suivante monte à sa place. C'est la carte
         * entière qui glisse, échelle comprise, comme dans le test où chaque
         * affirmation occupe un écran.
         *
         * LA SCÈNE DE L'URNE, en plus, quand le navigateur sait lier une
         * animation au défilement : la scène s'épingle, la démo s'arrête sur
         * la carte en cours, et c'est le défilement lui-même qui la fait tomber
         * dans l'urne. Voir `src/lib/demo-urne.ts`. Sans JavaScript, sans la
         * propriété, ou avec « réduire les animations », il n'y a ni urne ni
         * épinglage : la démo tourne seule, ou reste immobile.
         *
         * Tout le texte est dans le HTML : un robot ou un lecteur d'écran lit
         * les six affirmations comme une liste d'exemples.
         */
      }
      <div class="scene" data-scene>
        <div class="scene-collante">
          <figure class="demo" aria-label="Exemples d'affirmations du test, une par thème">
            <ul class="demo-pile">
              {
                DEMO.map((question) => (
                  <li class="demo-carte">
                    <div class="demo-corps">
                      <p class="demo-theme">{question.theme}</p>
                      <p class="demo-affirmation">{question.texte}</p>
                      <div class="demo-echelle" aria-hidden="true">
                        <div class="demo-points">
                          {ECHELLE_APERCU.map(() => (
                            <span />
                          ))}
                        </div>
                        <div class="demo-bornes">
                          <span>{ECHELLE_APERCU[0]}</span>
                          <span>{ECHELLE_APERCU[ECHELLE_APERCU.length - 1]}</span>
                        </div>
                        <span class="demo-sans-avis">Je n'ai pas d'avis</span>
                      </div>
                    </div>
                  </li>
                ))
              }
            </ul>
            {
              /*
               * Pour les lecteurs d'écran seulement. À l'œil, la liste des six
               * thèmes et cette légende sous la carte n'apportaient rien : le
               * thème en cours est déjà écrit sur la carte.
               */
            }
            <figcaption class="visuellement-masque">
              Aperçu non interactif&nbsp;: six des {QUESTIONS.length} affirmations, une par thème.
            </figcaption>
          </figure>

          {
            /*
             * Une urne transparente, comme celles des bureaux de vote : la carte
             * reste visible une fois dedans. Aucune couleur de parti, aucun
             * tricolore — les jetons du site, rien d'autre.
             */
          }
          <div class="urne" aria-hidden="true" data-urne>
            <svg class="urne-dessin" viewBox="0 0 200 150" width="200" height="150">
              <g class="urne-secousse">
                <g class="urne-enveloppes">
                  <rect x="36" y="112" width="52" height="32" rx="3" transform="rotate(-9 62 128)"
                  ></rect>
                  <rect x="84" y="116" width="52" height="30" rx="3" transform="rotate(6 110 131)"
                  ></rect>
                  <rect x="122" y="108" width="50" height="32" rx="3" transform="rotate(-4 147 124)"
                  ></rect>
                </g>
                <rect class="urne-corps" x="16" y="26" width="168" height="120" rx="8"></rect>
                <rect class="urne-couvercle" x="8" y="10" width="184" height="20" rx="5"></rect>
                <rect class="urne-fente" x="50" y="17" width="100" height="6" rx="3"></rect>
              </g>
            </svg>
          </div>
          <p class="urne-legende" aria-hidden="true">Dans le vrai test, c'est vous qui répondez.</p>
        </div>
      </div>

      <p class="action-etroite">
        <a class="action action--grand" href="/test">Commencer le test</a>
      </p>
    </div>
  </section>

  {
    /*
     * LA VITRINE, en deux temps : par sujet, puis par personne. On peut
     * comparer sans faire le test. Voir `src/components/accueil/`.
     */
  }
  <VitrineThemes />
  <VitrineCandidats />

  {
    articles.length > 0 && (
      <section class="section">
        <div class="enveloppe-large">
          <div class="section-tete revele">
            <h2>Comprendre avant de comparer</h2>
            <p class="section-chapo">
              Des réponses courtes et sourcées aux questions qu'on se pose avant un premier vote.
            </p>
          </div>

          {/*
           * Sur téléphone, un carrousel : on le fait glisser au doigt, et il
           * avance seul, sans fin — sinon le dernier article serait, de fait,
           * le moins lu. Les points disent où l'on en est ; le bouton arrête le
           * défilement automatique (WCAG 2.2.2). Voir `src/lib/carrousel.ts`.
           * Sans JavaScript, la rangée se fait glisser au doigt, sans points.
           *
           * La grille revient dès qu'il y a la place : tout y est visible,
           * rien n'y bouge. L'image est décorative (`alt=""`) : le titre du
           * lien porte le sens.
           */}
          <div
            class="carrousel"
            role="region"
            aria-roledescription="carrousel"
            aria-label="Articles pour comprendre l'élection"
            data-carrousel
          >
            <ul class="cartes" data-carrousel-piste>
              {articles.map((article, index) => {
                const image = illustration(article.id);
                return (
                  <li data-carrousel-item>
                    <a
                      class={`carte ${TEINTES[index % TEINTES.length]}`}
                      href={`/comprendre/${article.id}`}
                    >
                      {image && (
                        <span class="carte-image">
                          <img
                            src={image.cheminEtroit}
                            srcset={`${image.cheminEtroit} ${image.largeurEtroit}w, ${image.cheminLarge} ${image.largeurLarge}w`}
                            sizes="(min-width: 66rem) 23rem, (min-width: 46rem) 45vw, 82vw"
                            alt=""
                            width={image.largeurEtroit}
                            height={image.hauteurEtroit}
                            loading="lazy"
                            decoding="async"
                          />
                        </span>
                      )}
                      <span class="carte-texte">
                        <span class="carte-titre">{article.data.titre}</span>
                        <span class="carte-resume">{article.data.description}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>

            <div class="carrousel-commandes" hidden data-carrousel-commandes>
              <button
                class="carrousel-pause"
                type="button"
                aria-pressed="false"
                aria-label="Arrêter le défilement automatique"
                data-carrousel-pause
              >
                <span class="icone-pause">
                  <Icone nom="pause" graisse="fill" />
                </span>
                <span class="icone-lecture">
                  <Icone nom="play" graisse="fill" />
                </span>
              </button>
              <div class="carrousel-points">
                {articles.map((article, index) => (
                  <button
                    class="carrousel-point"
                    type="button"
                    aria-label={`Article ${index + 1} sur ${articles.length} : ${article.data.titre}`}
                    data-carrousel-point={index}
                  />
                ))}
              </div>
            </div>
          </div>

          <p class="apercu-note">
            <a href="/comprendre">Toutes les réponses</a>
          </p>
        </div>
      </section>
    )
  }

  {
    /*
     * LES PREUVES. Sur grand écran, le titre reste épinglé à gauche pendant
     * que les trois preuves défilent à droite. Chacune s'imprime comme un
     * tampon : son filet se trace, son icône tombe sur la page.
     */
  }
  <section class="section">
    <div class="enveloppe-large verifier">
      <div class="section-tete revele">
        <h2>Pourquoi vous pouvez vérifier ce site</h2>
        <p class="section-chapo">
          Un comparateur politique se juge sur ce qu'il accepte de montrer de lui-même.
        </p>
      </div>

      <ul class="preuves">
        {
          PREUVES.map((preuve, index) => (
            <li class={TEINTES[index % TEINTES.length]}>
              <span class="preuve-puce">
                <Icone nom={preuve.icone} />
              </span>
              <h3>{preuve.titre}</h3>
              <p>{preuve.texte}</p>
              <a href={preuve.lien}>
                {preuve.libelle}
                <Icone nom="arrow-right" graisse="bold" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    /*
     * L'ISOLOIR, EN FINALE. La promesse d'anonymat et l'appel au test ne font
     * plus qu'un bloc, sur l'aplat violet : on entre dans l'isoloir. Au
     * défilement, le bloc s'élargit jusqu'aux bords de l'écran, comme la photo
     * d'accroche, et sur grand écran l'isoloir dessiné ferme ses rideaux —
     * vous y êtes seul, vos réponses aussi. Puis l'appel : « Commencer le
     * test ».
     *
     * La promesse garde MOT POUR MOT la formulation publique de `CLAUDE.md`.
     * Sans animation, le bloc est à la largeur de la page, rideaux fermés.
     */
  }
  <div class="isoloir">
    <div class="isoloir-cadre">
      <div class="enveloppe-large isoloir-grille">
        <svg class="isoloir-dessin" viewBox="0 0 200 224" aria-hidden="true">
          <g class="isoloir-rideau isoloir-rideau--gauche">
            <path
              class="rideau-pan"
              d="M26 22 H100 V188 Q91 196 82 188 Q72 196 63 188 Q54 196 45 188 Q35 196 26 188 Z"
            ></path>
            <path class="rideau-pli" d="M44 26 V186 M63 26 V186 M82 26 V186"></path>
          </g>
          <g class="isoloir-rideau isoloir-rideau--droit">
            <path
              class="rideau-pan"
              d="M100 22 H174 V188 Q165 196 155 188 Q146 196 137 188 Q128 196 118 188 Q109 196 100 188 Z"
            ></path>
            <path class="rideau-pli" d="M118 26 V186 M137 26 V186 M156 26 V186"></path>
          </g>
          <path class="isoloir-bati" d="M16 220 V14 H184 V220"></path>
        </svg>

        <div class="isoloir-texte">
          <section class="promesse revele" aria-labelledby="promesse-titre">
            <h2 id="promesse-titre">
              C'est anonyme. Vos réponses ne sont enregistrées nulle part.
            </h2>
            <p>
              Vos réponses et vos résultats ne sont jamais envoyés, enregistrés ou associés à un
              identifiant. Le calcul s'effectue exclusivement dans votre navigateur. Il n'y a ni
              compte, ni inscription, ni bandeau de consentement, parce qu'il n'y a rien à
              consentir.
            </p>
          </section>

          <section class="final revele" aria-labelledby="final-titre">
            <h2 id="final-titre">Prêt à voir où vous vous situez&nbsp;?</h2>
            <p>{QUESTIONS.length} affirmations. Aucune inscription, rien à installer.</p>
            <p><a class="action action--grand" href="/test">Commencer le test</a></p>
          </section>
        </div>
      </div>
    </div>

    <nav class="enveloppe-large plus-loin" aria-label="Aller plus loin">
      <ul>
        {
          PLUS_LOIN.map((lien) => (
            <li>
              <a href={lien.href}>{lien.libelle}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <script>
    import { monterSceneUrne } from "../lib/demo-urne";
    import { monterCarrousel } from "../lib/carrousel";

    const scene = document.querySelector<HTMLElement>("[data-scene-racine]");
    if (scene) monterSceneUrne(scene);

    const carrousel = document.querySelector<HTMLElement>("[data-carrousel]");
    if (carrousel) monterCarrousel(carrousel);
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(articlesLd)} is:inline />
</BaseLayout>

<style>
  /* ─── Accroche ─────────────────────────────────────────────────────────── */

  /*
   * `overflow: clip`, JAMAIS `hidden`, sur tout ancêtre d'un élément animé au
   * défilement : `hidden` fait de l'élément un conteneur de défilement, et
   * `view()` s'y accroche — à un conteneur qui ne défile pas. L'animation
   * restait figée à son début, sans erreur. `clip` rogne pareil, sans cela.
   */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--pas-4) 0;
    overflow: clip;
  }

  /*
   * Halo de couleur. Il remplace le voile sombre posé sur la photographie : ici
   * la lumière vient du fond, le texte reste sur du clair, et le contraste ne
   * dépend plus d'un rideau. Aucune de ces teintes n'est une couleur de parti.
   */
  .hero::before {
    content: "";
    position: absolute;
    inset: -30% -20% auto -20%;
    height: 130%;
    z-index: -1;
    background:
      radial-gradient(48% 42% at 18% 18%, rgb(124 58 237 / 0.2), transparent 70%),
      radial-gradient(42% 38% at 82% 8%, rgb(14 116 144 / 0.16), transparent 70%),
      radial-gradient(40% 40% at 60% 60%, rgb(162 28 175 / 0.12), transparent 72%);
  }

  /*
   * Le titre à gauche, l'appel à droite sur grand écran ; l'un sous l'autre sur
   * téléphone. La photo vient ensuite, sur toute la largeur.
   */
  .hero-texte {
    display: grid;
    gap: var(--pas-3);
    margin-bottom: var(--pas-4);
  }

  @media (min-width: 62rem) {
    .hero {
      padding-block: var(--pas-5) 0;
    }

    .hero-texte {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: end;
      gap: var(--pas-6);
      margin-bottom: var(--pas-5);
    }
  }

  .hero h1 {
    font-size: var(--t-h1);
    line-height: 1.02;
    letter-spacing: -0.038em;
    max-width: 15ch;
    margin: 0;
  }

  /* Dans le H1 pour le référencement, en petit pour l'œil. */
  .surtitre {
    display: block;
    margin-bottom: var(--pas-2);
    font-size: var(--t-petit);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.3;
    color: var(--couleur-signature);
  }

  .hero-appel p {
    margin: 0;
  }

  .hero-sous {
    font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.3125rem);
    line-height: 1.5;
    color: var(--couleur-encre-faible);
    max-width: 38ch;
  }

  .hero-appel .hero-sous {
    margin-bottom: var(--pas-3);
  }

  /*
   * LA PHOTO, PLEINE LARGEUR. L'élément fait toute la largeur de l'écran ; un
   * `clip-path` n'en montre d'abord que la largeur de la page, arrondie. Le
   * défilement ouvre ce cadre jusqu'aux bords (voir DÉFILEMENT). Sans
   * animation liée au défilement, la photo reste à la largeur de la page.
   *
   * `--retrait` : la marge de chaque côté pour retomber sur la gouttière de
   * `.enveloppe-large`, quelle que soit la largeur de l'écran.
   */
  .hero-media {
    --retrait: max(var(--gouttiere), calc(50% - var(--large) / 2 + var(--gouttiere)));
    position: relative;
    aspect-ratio: 4 / 3;
    max-height: 78svh;
    width: 100%;
    overflow: clip;
    clip-path: inset(0 var(--retrait) round var(--rayon-carte-l));
  }

  @media (min-width: 48rem) {
    .hero-media {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 62rem) {
    .hero-media {
      aspect-ratio: 21 / 9;
    }
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 55%;
    display: block;
  }

  /*
   * LE RIDEAU S'OUVRE SUR LE BUREAU DE VOTE. Une fois, à l'arrivée : deux pans
   * violets, fermés au premier affichage, s'écartent vers les bords. C'est le
   * motif du logo et de la navigation, joué sur la photo.
   *
   * L'image est peinte DESSOUS dès le départ : le rideau ne retarde pas le plus
   * grand affichage de la page, que Lighthouse mesure. Par défaut, les pans sont
   * HORS CHAMP ; seule l'animation les amène d'abord au centre. Sans animation —
   * navigateur ancien ou « réduire les animations » —, la photo est simplement là.
   */
  .hero-media::before,
  .hero-media::after {
    content: "";
    position: absolute;
    inset-block: 0;
    z-index: 1;
    width: 50.5%;
    background: var(--couleur-aplat);
    pointer-events: none;
  }

  .hero-media::before {
    left: 0;
    transform: translateX(-101%);
  }

  .hero-media::after {
    right: 0;
    transform: translateX(101%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-media::before {
      animation: rideau-gauche 1s var(--va-et-vient) 0.25s both;
    }

    .hero-media::after {
      animation: rideau-droite 1s var(--va-et-vient) 0.25s both;
    }
  }

  @keyframes rideau-gauche {
    from {
      transform: none;
    }

    to {
      transform: translateX(-101%);
    }
  }

  @keyframes rideau-droite {
    from {
      transform: none;
    }

    to {
      transform: translateX(101%);
    }
  }

  /* ─── Phrase manifeste ─────────────────────────────────────────────────── */

  .manifeste {
    margin: 0 0 var(--pas-3);
    max-width: 16ch;
    font-size: clamp(2rem, 1.3rem + 3.4vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.038em;
    text-wrap: balance;
  }

  .manifeste-suite {
    margin: 0;
    max-width: 36ch;
    font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.3125rem);
    line-height: 1.5;
    color: var(--couleur-encre-faible);
  }

  /* ─── Comment ça marche : les étapes, puis la démo ─────────────────────── */

  /*
   * La carte qui sort de la pile part vers la gauche : `clip` la coupe au bord
   * de l'écran sans créer de défilement horizontal, et sans couper les ombres
   * en haut et en bas comme le ferait `hidden`. `clip` ne crée pas de conteneur
   * de défilement : l'épinglage (`sticky`) de la scène continue de fonctionner.
   */
  .fonctionnement-section {
    overflow-x: clip;
  }

  .fonctionnement {
    display: grid;
    gap: var(--pas-4);
  }

  /* Le bouton sous les étapes sur grand écran, sous la démo sur téléphone. */
  .action-large {
    display: none;
    margin: 0;
  }

  .action-etroite {
    margin: 0;
  }

  @media (min-width: 62rem) {
    .fonctionnement {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      column-gap: var(--pas-6);
      align-items: center;
    }

    .action-large {
      display: block;
    }

    .action-etroite {
      display: none;
    }
  }

  .etapes {
    list-style: none;
    margin: var(--pas-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--pas-3);
  }

  .etapes li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--pas-2);
    align-items: start;
    margin: 0;
  }

  .etape-numero {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 14px;
    background: var(--couleur-surface-2);
    color: var(--couleur-signature);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .etapes h3 {
    margin: 0 0 2px;
    font-size: 1.0625rem;
  }

  .etapes p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--couleur-encre-faible);
  }

  @media (min-width: 62rem) {
    .etapes {
      margin-bottom: var(--pas-4);
    }

    .etapes li {
      gap: var(--pas-3);
    }

    .etape-numero {
      width: 2.75rem;
      height: 2.75rem;
      font-size: 1.25rem;
    }

    .etapes h3 {
      font-size: 1.125rem;
    }

    .etapes p {
      font-size: var(--t-corps);
    }
  }

  /* ─── La démo ──────────────────────────────────────────────────────────── */

  .demo {
    position: relative;
    z-index: 1;
    margin: 0;
  }

  /*
   * LA PILE. Les six cartes occupent la même case : la plus haute fixe la
   * taille, les autres s'étirent. Derrière, deux cartes VIDES dessinées en
   * pseudo-éléments dépassent de 12 et 24 px : ce sont elles qui portent la
   * profondeur.
   *
   * POURQUOI PAS LES VRAIES CARTES, RÉDUITES, COMME AVANT. Une carte qui
   * s'agrandit de 0,9 à 1 pendant une animation sans fin est dessinée par
   * Safari — et par Chrome sur certains processeurs graphiques — à sa taille
   * de départ, puis étirée : le texte sortait flou. Les cartes qui portent du
   * texte ne changent donc JAMAIS d'échelle en boucle ; seules les cartes
   * vides le font, et elles n'ont rien à rendre net.
   */
  .demo-pile {
    position: relative;
    isolation: isolate;
    display: grid;
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
  }

  .demo-pile::before,
  .demo-pile::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid var(--couleur-trait);
    border-radius: var(--rayon-carte-l);
    background: var(--couleur-surface);
    transform-origin: 50% 100%;
  }

  .demo-pile::before {
    transform: translateY(12px) scale(0.95);
    opacity: 0.85;
  }

  .demo-pile::after {
    z-index: -2;
    transform: translateY(24px) scale(0.9);
    opacity: 0.55;
  }

  /* L'emplacement : il bouge dans la boucle. Le corps, lui, tombe dans l'urne. */
  .demo-carte {
    grid-area: 1 / 1;
    display: flex;
    margin: 0;
    z-index: 1;
    opacity: 0;
  }

  .demo-carte:first-child {
    z-index: 4;
    opacity: 1;
  }

  .demo-corps {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--pas-3);
    border: 1px solid var(--couleur-trait);
    border-radius: var(--rayon-carte-l);
    background: var(--couleur-surface);
    box-shadow: var(--ombre-2);
  }

  @media (min-width: 48rem) {
    .demo-corps {
      padding: var(--pas-4);
    }
  }

  .demo-theme {
    align-self: flex-start;
    margin: 0 0 var(--pas-2);
    padding: 0.3rem 0.85rem;
    border-radius: var(--rayon-actionnable);
    background: var(--couleur-surface-2);
    color: var(--couleur-signature);
    font-size: var(--t-petit);
    font-weight: 700;
  }

  .demo-affirmation {
    margin: 0 0 var(--pas-3);
    font-size: clamp(1.15rem, 1.02rem + 0.7vw, 1.55rem);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.026em;
    text-wrap: pretty;
  }

  /* L'échelle, en réduction : cinq pastilles sur un fil, les deux bouts écrits. */
  .demo-echelle {
    margin-top: auto;
    display: grid;
    gap: 0.4rem;
  }

  .demo-points {
    position: relative;
    display: flex;
    justify-content: space-between;
  }

  .demo-points::before {
    content: "";
    position: absolute;
    inset-inline: 0.6rem;
    top: 50%;
    height: 2px;
    background: var(--couleur-trait);
  }

  .demo-points span {
    position: relative;
    width: 1.3rem;
    height: 1.3rem;
    border: 2px solid var(--couleur-encre-faible);
    border-radius: 50%;
    background: var(--couleur-surface);
  }

  .demo-bornes {
    display: flex;
    justify-content: space-between;
    gap: var(--pas-2);
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--couleur-encre-faible);
  }

  .demo-bornes span:last-child {
    text-align: right;
  }

  .demo-sans-avis {
    justify-self: center;
    margin-top: 0.35rem;
    padding: 0.25rem 0.8rem;
    border: 1.5px dashed var(--couleur-trait);
    border-radius: var(--rayon-actionnable);
    font-size: 0.8125rem;
    color: var(--couleur-encre-faible);
  }

  .apercu-note {
    margin: var(--pas-2) 0 0;
    font-size: var(--t-petit);
    color: var(--couleur-encre-faible);
  }

  /* Une vraie cible : 17 px de haut collés aux cartes, l'audit la refusait. */
  .apercu-note a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /*
   * LE MOUVEMENT. Un cycle de 21 s, six fenêtres de 3,5 s. À la fin de chaque
   * fenêtre, pendant la même demi-seconde, la carte de devant part vers la
   * gauche en pivotant et la suivante monte de la pile, en fondu.
   *
   * Les délais sont NÉGATIFS : au chargement, chaque carte est déjà à sa place
   * dans le cycle. Positifs, ils laisseraient les six cartes empilées devant
   * pendant leur attente.
   *
   * Seules `transform` et `opacity` bougent, et jamais `scale` (voir la pile).
   * `z-index` change par paliers : la carte de devant garde 4 jusqu'au bout de
   * sa sortie, celle qui monte passe de 1 à 4, donc celle qui part glisse
   * PAR-DESSUS, comme une carte qu'on écarte du doigt. Au survol, tout
   * s'arrête : on doit pouvoir lire une affirmation jusqu'au bout.
   */
  @media (prefers-reduced-motion: no-preference) {
    .demo-carte {
      animation: demo-pile 21s var(--sortie) infinite both;
    }

    .demo-carte:nth-child(2) {
      animation-delay: -17.5s;
    }

    .demo-carte:nth-child(3) {
      animation-delay: -14s;
    }

    .demo-carte:nth-child(4) {
      animation-delay: -10.5s;
    }

    .demo-carte:nth-child(5) {
      animation-delay: -7s;
    }

    .demo-carte:nth-child(6) {
      animation-delay: -3.5s;
    }

    .demo:hover .demo-carte,
    .demo--figee .demo-carte {
      animation-play-state: paused;
    }
  }

  @keyframes demo-pile {
    0%,
    14.3% {
      z-index: 4;
      opacity: 1;
      transform: none;
    }

    16.6% {
      z-index: 4;
      opacity: 0;
      transform: translateX(-30%) rotate(-5deg);
    }

    16.7%,
    97.6% {
      z-index: 1;
      opacity: 0;
      transform: translateY(12px);
    }

    100% {
      z-index: 4;
      opacity: 1;
      transform: none;
    }
  }

  /* ─── La scène de l'urne ───────────────────────────────────────────────── */

  /*
   * Rien de tout ceci n'existe tant que `src/lib/demo-urne.ts` n'a pas posé
   * `.scene-active` : pas d'urne, pas d'épinglage, pas de piste de défilement.
   * Le script ne la pose que si le navigateur lie les animations au
   * défilement, si « réduire les animations » n'est pas demandé, et si la
   * scène tient dans la hauteur de l'écran.
   */
  .urne,
  .urne-legende {
    display: none;
  }

  /*
   * La PISTE : une scène haute d'un écran, plus la distance de défilement
   * pendant laquelle la carte tombe. La partie COLLANTE reste à l'écran
   * pendant ce temps. La chronologie `--scene` suit la piste.
   */
  .scene-active .scene {
    --scene-haut: 4.5rem;
    height: calc(100svh - var(--scene-haut) + 110svh);
    view-timeline-name: --scene;
    view-timeline-axis: block;
  }

  .scene-active .scene-collante {
    position: sticky;
    top: var(--scene-haut);
    height: calc(100svh - var(--scene-haut));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--pas-2);
  }

  @media (min-width: 62rem) {
    .scene-active .scene {
      --scene-haut: 5.5rem;
    }

    /* Sur grand écran, les étapes restent en face de la scène épinglée. */
    .fonctionnement.scene-active {
      align-items: start;
    }

    .scene-active .fonctionnement-texte {
      position: sticky;
      top: calc(5.5rem + var(--pas-6));
    }
  }

  .scene-active .urne {
    display: block;
    position: relative;
    z-index: 2;
    align-self: center;
    width: min(46vw, 13rem);
  }

  @media (min-width: 62rem) {
    .scene-active .urne {
      width: 16rem;
    }
  }

  /*
   * LA QUESTION SUIVANTE monte pendant que l'autre tombe : la scène ne se vide
   * pas. Le script la sort de la boucle (`animation: none`) le temps de la
   * scène, puis l'y remet, resynchronisée, quand on remonte.
   */
  .scene-active .demo-carte.est-suivante {
    z-index: 3;
    opacity: 1;
    animation: none;
  }

  .urne-dessin {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .urne-enveloppes rect {
    fill: var(--couleur-surface-2);
    stroke: var(--couleur-trait);
    stroke-width: 1.5;
  }

  /* Transparente, comme une vraie : la carte se voit une fois dedans. */
  .urne-corps {
    fill: var(--couleur-surface);
    fill-opacity: 0.55;
    stroke: var(--couleur-encre-faible);
    stroke-width: 2.5;
  }

  .urne-couvercle {
    fill: var(--couleur-surface-2);
    stroke: var(--couleur-encre-faible);
    stroke-width: 2.5;
  }

  .urne-fente {
    fill: var(--couleur-encre);
  }

  .scene-active .urne-legende {
    display: block;
    margin: 0;
    text-align: center;
    font-size: var(--t-petit);
    font-weight: 600;
    color: var(--couleur-encre-faible);
  }

  /*
   * LA CHUTE, liée au défilement. Seule la carte que le script a marquée
   * `.est-devant` — celle qu'on lisait quand la démo s'est arrêtée — tombe.
   * Trajectoire : un léger recul (l'élan), la carte se réduit à la largeur
   * de la fente en pivotant, se redresse au-dessus, puis s'enfonce.
   *
   * Les distances ne se devinent pas en CSS : le script mesure la scène et
   * écrit `--chute-haut`, `--chute-bas` (en px) et `--chute-echelle`.
   *
   * Ici, la carte PERD de l'échelle : réduire un texte déjà dessiné net ne le
   * rend pas flou. C'est l'agrandissement qui le faisait.
   */
  @supports (view-timeline-name: --scene) {
    .scene-active .est-devant .demo-corps {
      transform-origin: 50% 50%;
      animation-name: demo-chute;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --scene;
      animation-range: contain 12% contain 78%;
    }

    .scene-active .est-suivante .demo-corps {
      animation-name: demo-suivante;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --scene;
      animation-range: contain 46% contain 74%;
    }

    .scene-active .urne-dessin {
      animation-name: urne-monte;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --scene;
      animation-range: contain 0% contain 14%;
    }

    .scene-active .urne-secousse {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation-name: urne-secousse;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --scene;
      animation-range: contain 74% contain 86%;
    }

    .scene-active .urne-legende {
      animation-name: urne-legende;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --scene;
      animation-range: contain 78% contain 90%;
    }
  }

  @keyframes demo-chute {
    0% {
      transform: none;
    }

    14% {
      transform: translateY(-10px) rotate(-1.5deg) scale(0.98);
    }

    62% {
      transform: translateY(var(--chute-haut)) rotate(-7deg) scale(var(--chute-echelle));
    }

    74% {
      transform: translateY(var(--chute-haut)) rotate(0deg) scale(var(--chute-echelle));
    }

    100% {
      transform: translateY(var(--chute-bas)) rotate(0deg) scale(var(--chute-echelle));
    }
  }

  /* Pleine avant d'être en place : à mi-fondu, on voyait la pile à travers. */
  @keyframes demo-suivante {
    0% {
      opacity: 0;
      transform: translateY(12px);
    }

    35% {
      opacity: 1;
    }

    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes urne-monte {
    from {
      opacity: 0.3;
      transform: translateY(2rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes urne-secousse {
    0%,
    100% {
      transform: none;
    }

    40% {
      transform: translateY(4px) scaleY(0.97);
    }

    70% {
      transform: translateY(-2px);
    }
  }

  @keyframes urne-legende {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ─── Cartes Comprendre ────────────────────────────────────────────────── */

  /*
   * Téléphone : une rangée à faire glisser. Elle déborde jusqu'aux bords de
   * l'écran (marges négatives), et `scroll-padding` aligne chaque carte sur la
   * gouttière de la page. Grille à partir de 46 rem.
   *
   * `position: relative` : le script mesure chaque carte par `offsetLeft`,
   * qui doit se lire depuis la rangée.
   */
  .cartes {
    position: relative;
    list-style: none;
    display: flex;
    gap: var(--pas-2);
    margin: 0 calc(var(--gouttiere) * -1);
    /* 12 px au-dessus : la carte focalisée monte de 4 px, et son contour ne doit pas être rogné. */
    padding: var(--pas-2) var(--gouttiere);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gouttiere);
    scrollbar-width: none;
  }

  .cartes::-webkit-scrollbar {
    display: none;
  }

  /* La carte en cours est CENTRÉE : ses deux voisines dépassent de part et d'autre. */
  .cartes li {
    flex: 0 0 78%;
    margin: 0;
    scroll-snap-align: center;
  }

  /*
   * LA CARTE EN COURS, MISE EN AVANT. Elle monte et prend l'ombre haute quand
   * elle devient la carte en cours, et sa photo avance lentement pendant le
   * délai, au rythme du point qui se remplit. Téléphone seulement : la grille,
   * elle, n'a pas de carte en cours.
   */
  @media (max-width: 45.99rem) {
    .cartes :global(li.est-active) .carte {
      transform: translateY(-6px);
      box-shadow: var(--ombre-2);
    }

    @media (prefers-reduced-motion: no-preference) {
      .cartes :global(li.est-active) .carte-image img {
        animation: carrousel-zoom var(--carrousel-delai) linear both;
      }

      .carrousel--pause .cartes :global(li.est-active) .carte-image img {
        animation-play-state: paused;
      }
    }
  }

  @keyframes carrousel-zoom {
    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.08);
    }
  }

  @media (min-width: 46rem) {
    .cartes {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--pas-3);
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }

  /* Trois secondes par carte : le délai de la barre, du zoom et de l'avance. */
  .carrousel {
    --carrousel-delai: 3s;
  }

  /*
   * Les commandes du carrousel : un bouton pause, puis un point par article.
   * Le point en cours s'allonge et se remplit pendant le délai avant la carte
   * suivante — c'est la fin de SON animation qui fait avancer le carrousel,
   * donc la barre et le défilement ne peuvent pas se désynchroniser.
   */
  .carrousel-commandes {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--pas-1);
    margin-top: var(--pas-1);
  }

  .carrousel-commandes[hidden],
  .carrousel-pause[hidden] {
    display: none;
  }

  .carrousel-points {
    display: flex;
    align-items: center;
  }

  /* 44 px de haut pour le doigt, un point de 8 px pour l'œil. */
  .carrousel-point,
  .carrousel-pause {
    display: grid;
    place-items: center;
    min-width: 24px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--couleur-encre-faible);
    cursor: pointer;
  }

  .carrousel-pause {
    min-width: 44px;
  }

  .carrousel-pause :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .icone-lecture,
  .carrousel-pause[aria-pressed="true"] .icone-pause {
    display: none;
  }

  .carrousel-pause[aria-pressed="true"] .icone-lecture {
    display: inline;
  }

  .carrousel-point::before {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: var(--couleur-trait);
    background-image: linear-gradient(var(--couleur-signature), var(--couleur-signature));
    background-repeat: no-repeat;
    background-size: 0% 100%;
    transition: width var(--duree) var(--sortie);
  }

  .carrousel-point[aria-current="true"]::before {
    width: 28px;
    background-size: 100% 100%;
  }

  /*
   * Le remplissage. `background-size` n'est ni `transform` ni `opacity`, mais
   * un point de 28 × 8 px ne coûte rien à repeindre, et un `scaleX` sur un
   * pseudo-élément arrondi déformerait ses bouts.
   */
  @media (prefers-reduced-motion: no-preference) {
    .carrousel-point.en-cours::before {
      animation: carrousel-minuterie var(--carrousel-delai) linear both;
    }

    .carrousel--pause .carrousel-point.en-cours::before {
      animation-play-state: paused;
    }
  }

  @keyframes carrousel-minuterie {
    from {
      background-size: 0% 100%;
    }

    to {
      background-size: 100% 100%;
    }
  }

  /*
   * Grille, à partir de 46 rem : ni copies, ni commandes. Ces règles viennent
   * APRÈS celles des commandes : à spécificité égale, la dernière gagne, et
   * placées avant, elles laissaient les points s'afficher sur ordinateur.
   */
  @media (min-width: 46rem) {
    .cartes :global(.carte-copie),
    .carrousel-commandes,
    .carrousel-commandes[hidden] {
      display: none;
    }
  }

  @media (min-width: 66rem) {
    .cartes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .carte {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: clip;
    background: var(--pastel, var(--couleur-surface));
    border-radius: var(--rayon-carte);
    color: var(--couleur-encre);
    text-decoration: none;
    transition:
      transform 220ms var(--sortie),
      box-shadow 220ms var(--sortie);
  }

  .carte-image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: clip;
  }

  .carte-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms var(--sortie);
  }

  /*
   * LE RIDEAU DE CHAQUE PHOTO, sur grand écran. Deux pans à la teinte vive de
   * la rubrique couvrent la photo et s'ouvrent vers les bords quand la carte
   * arrive : le geste de l'accroche, rejoué à chaque article. Des formes
   * vides, sans texte. Par défaut ouverts — sur téléphone, et sans animation
   * liée au défilement, la photo est simplement là.
   */
  .carte-image {
    position: relative;
  }

  .carte-image::before,
  .carte-image::after {
    content: "";
    position: absolute;
    inset-block: 0;
    z-index: 1;
    width: calc(50% + 0.5px);
    background: var(--vif, var(--couleur-aplat));
    transform: scaleX(0);
    pointer-events: none;
  }

  .carte-image::before {
    left: 0;
    transform-origin: left center;
  }

  .carte-image::after {
    right: 0;
    transform-origin: right center;
  }

  .carte-texte {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--pas-3);
  }

  .carte-titre {
    font-size: var(--t-h3);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .carte-resume {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: var(--t-petit);
    line-height: 1.45;
    color: var(--couleur-encre-faible);
  }

  /*
   * Survol et focus clavier : la carte monte, la photo avance. Le survol est
   * réservé aux pointeurs fins — sur un écran tactile, il resterait collé.
   */
  @media (hover: hover) and (pointer: fine) {
    .carte:hover {
      transform: translateY(-4px);
      box-shadow: var(--ombre-2);
    }

    .carte:hover .carte-image img {
      transform: scale(1.06);
    }

    .carte:hover .carte-titre {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  /* Au clavier, le même état, mais instantané : aucune animation sur une action clavier. */
  .carte:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--ombre-2);
    transition: none;
  }

  .carte:focus-visible .carte-image img {
    transform: scale(1.06);
    transition: none;
  }

  /* ─── Preuves de confiance ─────────────────────────────────────────────── */

  /*
   * Sur grand écran, deux colonnes : le titre épinglé à gauche, les preuves
   * qui défilent à droite. Sur téléphone, l'un sous l'autre.
   */
  @media (min-width: 62rem) {
    .verifier {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      column-gap: var(--pas-6);
      align-items: start;
    }

    .verifier .section-tete {
      position: sticky;
      top: calc(5.5rem + var(--pas-4));
      margin-bottom: 0;
    }
  }

  .preuves {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--pas-5);
  }

  /*
   * Le trait, pas la boîte : un filet au-dessus de chaque preuve, qui se trace
   * au défilement (voir DÉFILEMENT). L'icône à gauche du texte, toujours.
   */
  .preuves li {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--pas-3);
    align-content: start;
    margin: 0;
    padding-top: var(--pas-4);
  }

  .preuves li::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--couleur-trait);
    transform-origin: left center;
  }

  .preuves li > :not(.preuve-puce) {
    grid-column: 2;
  }

  .preuve-puce {
    grid-row: 1 / span 3;
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--pastel, var(--pastel-violet));
    color: var(--vif, var(--couleur-signature));
  }

  .preuve-puce :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    transition: transform 240ms var(--sortie);
  }

  @media (min-width: 48rem) {
    .preuve-puce {
      width: 4.5rem;
      height: 4.5rem;
    }

    .preuve-puce :global(svg) {
      width: 2.2rem;
      height: 2.2rem;
    }
  }

  .preuves h3 {
    margin: 0.2rem 0 0.4rem;
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .preuves p {
    margin: 0 0 var(--pas-2);
    color: var(--couleur-encre-faible);
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: 38rem;
  }

  /* Zone de confort tactile : la cible grandit, la mise en page ne bouge pas. */
  .preuves a {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    margin-block: -0.4rem;
    padding-block: 0.4rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .preuves a :global(svg) {
    width: 1rem;
    height: 1rem;
    transition: transform var(--duree) var(--sortie);
  }

  /* Survol : l'icône bascule dans son disque, la flèche avance. */
  @media (hover: hover) and (pointer: fine) {
    .preuves li:hover .preuve-puce :global(svg) {
      transform: rotate(-12deg) scale(1.12);
    }

    .preuves a:hover :global(svg) {
      transform: translateX(3px);
    }
  }

  /* ─── L'isoloir : promesse d'anonymat et appel final ───────────────────── */

  .isoloir {
    padding-top: var(--pas-5);
  }

  /*
   * LE BLOC, PLEINE LARGEUR. L'élément fait toute la largeur de l'écran ; un
   * `clip-path` n'en montre d'abord que la largeur de la page, arrondie, et le
   * défilement l'ouvre jusqu'aux bords — le geste de la photo d'accroche.
   * `--retrait` retombe sur la gouttière de `.enveloppe-large`.
   */
  .isoloir-cadre {
    --retrait: max(var(--gouttiere), calc(50% - var(--large) / 2 + var(--gouttiere)));
    padding-block: var(--pas-6);
    background: var(--couleur-aplat);
    color: var(--couleur-sur-aplat);
    clip-path: inset(0 var(--retrait) round var(--rayon-carte-l));
  }

  /* Le texte garde de l'air à l'intérieur du cadre, même avant son ouverture. */
  .isoloir-grille {
    display: grid;
    gap: var(--pas-5);
    padding-inline: calc(var(--gouttiere) + var(--pas-3));
  }

  @media (min-width: 48rem) {
    .isoloir-grille {
      padding-inline: calc(var(--gouttiere) + var(--pas-5));
    }
  }

  @media (min-width: 62rem) {
    .isoloir-cadre {
      padding-block: calc(var(--pas-6) * 1.5);
    }

    .isoloir-grille {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      column-gap: var(--pas-6);
      align-items: center;
    }
  }

  /*
   * L'ISOLOIR DESSINÉ, aux couleurs de l'aplat : bâti en trait, rideaux
   * translucides. Les rideaux, fermés par défaut, s'ouvrent vers les bords
   * avant que le bloc n'arrive, et se ferment en défilant. `non-scaling-stroke`
   * garde les plis nets pendant que les pans changent de largeur.
   */
  /*
   * Sur grand écran seulement, en face du texte. Sur téléphone, empilé
   * au-dessus, il repoussait la promesse d'un écran pour une animation que le
   * bloc qui s'élargit suffit à porter (décision de l'éditeur, 27 septembre
   * 2026).
   */
  .isoloir-dessin {
    display: none;
  }

  @media (min-width: 62rem) {
    .isoloir-dessin {
      display: block;
      width: 100%;
      max-width: 21rem;
      height: auto;
      justify-self: center;
      overflow: visible;
    }
  }

  .isoloir-bati {
    fill: none;
    stroke: var(--couleur-sur-aplat);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rideau-pan {
    fill: var(--couleur-sur-aplat);
    fill-opacity: 0.22;
  }

  .rideau-pli {
    fill: none;
    stroke: var(--couleur-sur-aplat);
    stroke-opacity: 0.4;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .isoloir-rideau {
    transform-box: fill-box;
  }

  .isoloir-rideau--gauche {
    transform-origin: left center;
  }

  .isoloir-rideau--droit {
    transform-origin: right center;
  }

  .isoloir-texte {
    display: grid;
    gap: var(--pas-5);
  }

  .promesse h2 {
    margin: 0 0 var(--pas-3);
    max-width: 20ch;
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .promesse p {
    margin: 0;
    max-width: 52ch;
    line-height: 1.6;
  }

  /*
   * Un filet entre la promesse et l'appel : la teinte du texte mêlée à
   * l'aplat, `in srgb` pour que `capturer.mjs` sache la lire.
   */
  .final {
    padding-top: var(--pas-5);
    border-top: 1px solid color-mix(in srgb, var(--couleur-sur-aplat) 40%, var(--couleur-aplat));
  }

  .final h2 {
    margin: 0 0 var(--pas-2);
    font-size: var(--t-h2);
    text-wrap: balance;
  }

  .final p {
    margin: 0 0 var(--pas-4);
  }

  .final p:last-child {
    margin-bottom: 0;
  }

  .isoloir h2,
  .isoloir p {
    color: var(--couleur-sur-aplat);
  }

  /*
   * L'action, inversée sur l'aplat : fond de la teinte du texte, texte de la
   * teinte du fond. Même bouton, mêmes deux valeurs mesurées. L'anneau de
   * focus prend la teinte du texte : violet sur violet, il ne se verrait pas.
   */
  .isoloir .action {
    background: var(--couleur-sur-aplat);
    color: var(--couleur-aplat);
    box-shadow: none;
  }

  .isoloir :focus-visible {
    outline-color: var(--couleur-sur-aplat);
    outline-offset: 3px;
  }

  /*
   * « Aller plus loin » : des pilules qui tirent leurs deux demi-rideaux au
   * survol, comme les liens du menu.
   */
  .plus-loin ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--pas-1) var(--pas-2);
    list-style: none;
    margin: 0;
    padding: var(--pas-5) 0 var(--pas-6);
  }

  .plus-loin li {
    margin: 0;
  }

  .plus-loin a {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 1.1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .plus-loin a::before,
  .plus-loin a::after {
    content: "";
    position: absolute;
    inset-block: 0;
    z-index: -1;
    width: calc(50% + 0.5px);
    background: var(--couleur-surface-2);
    transform: scaleX(0);
    transition: transform 220ms var(--sortie);
  }

  .plus-loin a::before {
    left: 0;
    transform-origin: left center;
    border-radius: var(--rayon-actionnable) 0 0 var(--rayon-actionnable);
  }

  .plus-loin a::after {
    right: 0;
    transform-origin: right center;
    border-radius: 0 var(--rayon-actionnable) var(--rayon-actionnable) 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .plus-loin a:hover::before,
    .plus-loin a:hover::after {
      transform: scaleX(1);
    }
  }

  /*
   * ─── DÉFILEMENT ──────────────────────────────────────────────────────────
   *
   * Trois filets, comme `.revele` dans base.css : `no-preference`, `@supports`,
   * et un état par défaut VISIBLE. Propriétés détaillées, jamais le raccourci
   * `animation` : le minifieur le fusionne avec `animation-timeline` en une
   * valeur que Chrome rejette.
   *
   * AUCUN TEXTE NE PERD DE CONTRASTE, même avant qu'on ait défilé. Un audit
   * (Lighthouse, axe) lit la page sans la faire défiler : des mots à 25 %
   * d'opacité y comptaient comme des textes illisibles, et l'accessibilité
   * était tombée de 100 à 96. Le texte bouge donc par `transform`, ou change
   * de couleur entre deux teintes qui passent AA ; l'opacité ne touche que les
   * images et les formes.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /*
       * Le cadre de la photo s'ouvre jusqu'aux bords de l'écran. La plage
       * commence là où la photo se trouve au chargement : elle est donc
       * encore à la largeur de la page tant qu'on n'a pas défilé.
       */
      .hero-media {
        animation-name: accueil-photo;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 85% cover 62%;
      }

      .hero-media img {
        animation-name: accueil-parallaxe;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }

      /* Le texte de l'accroche prend de l'avance en sortant par le haut : la photo passe dessous. */
      .hero-texte {
        animation-name: accueil-sortie;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }

      /*
       * La phrase courte s'allume mot à mot, dans l'ordre de lecture : tous les
       * mots suivent la chronologie du PARAGRAPHE, chacun sur sa tranche.
       * Une chronologie par mot allumait une ligne entière d'un coup.
       */
      .manifeste {
        --mots: 8;
        view-timeline-name: --manifeste;
      }

      /*
       * Le rang de chaque mot, par sa place : un `style="--rang: 3"` posé au
       * build serait bloqué par la CSP, qui n'autorise aucun style en ligne.
       * Douze rangs couvrent la phrase ; `--mots` doit suivre sa longueur.
       */
      .mot {
        --rang: 0;
      }

      .mot:nth-child(2) {
        --rang: 1;
      }

      .mot:nth-child(3) {
        --rang: 2;
      }

      .mot:nth-child(4) {
        --rang: 3;
      }

      .mot:nth-child(5) {
        --rang: 4;
      }

      .mot:nth-child(6) {
        --rang: 5;
      }

      .mot:nth-child(7) {
        --rang: 6;
      }

      .mot:nth-child(8) {
        --rang: 7;
      }

      .mot:nth-child(9) {
        --rang: 8;
      }

      .mot:nth-child(10) {
        --rang: 9;
      }

      .mot:nth-child(11) {
        --rang: 10;
      }

      .mot:nth-child(12) {
        --rang: 11;
      }

      .mot {
        --tranche: calc(30% / var(--mots));
        animation-name: accueil-mot;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --manifeste;
        animation-range: cover calc(22% + var(--rang) * var(--tranche)) cover
          calc(22% + (var(--rang) + 1.6) * var(--tranche));
      }

      /*
       * Carrousel : la carte au centre de la rangée est pleine, celles qui
       * entrent et sortent sont en retrait. La chronologie est celle du
       * défilement HORIZONTAL de la rangée. Seule la PHOTO s'estompe : un
       * texte estompé compte comme illisible pour un audit, et une carte qui
       * s'agrandit en défilant sortait floue sur Safari.
       */
      @media (max-width: 45.99rem) {
        .cartes .carte-image {
          animation-name: accueil-carrousel;
          animation-duration: auto;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: view(inline);
          animation-range: cover 0% cover 100%;
        }
      }

      /* Grille : les cartes montent en cascade. */
      @media (min-width: 46rem) {
        .cartes li {
          animation-name: accueil-monte;
          animation-duration: auto;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: view();
          animation-range: entry 0% entry 55%;
        }

        .cartes li:nth-child(3n + 2) {
          animation-range: entry 10% entry 65%;
        }

        .cartes li:nth-child(3n) {
          animation-range: entry 20% entry 75%;
        }
      }

      /*
       * Les rideaux des photos s'ouvrent, sur grand écran seulement : chaque
       * carte suit sa propre chronologie, d'où la cascade des colonnes. Sur
       * téléphone, le carrousel porte déjà le mouvement (défilement, carte
       * mise en avant, photo qui avance) : un rideau de plus n'y ajoutait
       * rien, décision de l'éditeur du 27 septembre 2026.
       */
      @media (min-width: 46rem) {
        .carte-image {
          view-timeline-name: --photo;
        }

        .carte-image::before,
        .carte-image::after {
          animation-name: accueil-rideau-photo;
          animation-duration: auto;
