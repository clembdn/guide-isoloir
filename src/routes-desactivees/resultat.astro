---
/*
 * Route du résultat — DÉSACTIVÉE, voir src/routes-desactivees/README.md.
 *
 * Ce fichier vit hors de `src/pages/` : Astro ne le construit pas, la route
 * n'existe pas. L'écran tourne sur des ACTEURS ET POSITIONS FACTICES. Le
 * garde-fou de publication (`scripts/verifier-pages-publiques.mjs`) refuse un
 * build de production tant que c'est le cas — d'où l'absence de cette route
 * plutôt qu'un garde-fou affaibli.
 *
 * Une fois remise dans `src/pages/resultat.astro` avec de vraies données :
 *
 * `noindex, nofollow` est définitif : un résultat indexé serait un problème de
 * confidentialité autant que de neutralité. La page n'est pas bloquée dans
 * robots.txt, sinon aucun robot ne pourrait lire cette directive.
 *
 * AUCUN IDENTIFIANT NE FIGURE JAMAIS DANS CETTE URL. Les réponses transitent par
 * le stockage de session, jamais par l'adresse : une URL de résultat partagée,
 * copiée dans un historique ou envoyée dans un `Referer` exposerait des opinions
 * politiques. `tests/e2e/resultat.spec.ts` le vérifie — aujourd'hui en
 * `test.skip`.
 *
 * Contrainte permanente une fois réactivée : aucun script tiers, aucune police
 * distante, aucun analytics sur cette route.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Resultat from "../components/Resultat.svelte";
import { validerQuestions } from "../lib/questions";
import { QUESTIONS_FACTICES } from "../factice/questions-factices";
import { projeter } from "../lib/projection";
import {
  ACTEURS_FACTICES,
  AVERTISSEMENT_ACTEURS_FACTICES,
  POSITIONS_FACTICES,
} from "../factice/acteurs-factices";

/*
 * Validation au build. Ce frontmatter ne s'exécute QUE côté serveur : le schéma
 * zod échoue le build si une question est mal formée, sans partir dans le
 * bundle. Une infobulle sans source, un thème vide ou un identifiant en double
 * arrêtent la construction ici.
 */
validerQuestions(QUESTIONS_FACTICES);

/*
 * Projection : l'îlot ne reçoit que ce qui s'affiche. `direction` reste ici,
 * côté serveur, et n'est ni rendu ni embarqué dans le bundle.
 */
const questions = projeter(QUESTIONS_FACTICES);
---

<BaseLayout
  title="Votre résultat"
  description="Résultat du test comparatif de Guide Isoloir, calculé dans votre navigateur."
  noindex={true}
>
  <h1>Votre résultat</h1>

  <p>
    Ce résultat a été calculé dans votre navigateur, à partir des réponses conservées dans cet
    onglet. Il n'a été ni envoyé, ni enregistré, ni associé à un identifiant.
  </p>

  <Resultat
    client:load
    questions={questions}
    acteurs={ACTEURS_FACTICES}
    positions={POSITIONS_FACTICES}
    avertissement={AVERTISSEMENT_ACTEURS_FACTICES}
  />

  <noscript>
    <p class="reserve">
      Le calcul se fait dans votre navigateur, et il a besoin de JavaScript. Sans lui, il n'y a rien
      à afficher ici : vos réponses ne sont stockées nulle part ailleurs, et aucun serveur ne peut
      les calculer à votre place.
    </p>
  </noscript>

  <p>
    La <a href="/methodologie">méthodologie</a> explique comment les positions sont établies, ce que le
    calcul fait, et ce qu'il ne fait pas.
  </p>
</BaseLayout>
