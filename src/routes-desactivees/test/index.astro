---
/*
 * Route du test comparatif — DÉSACTIVÉE, voir src/routes-desactivees/README.md.
 *
 * Ce fichier vit hors de `src/pages/` : Astro ne le construit pas, la route
 * n'existe pas. L'écran fonctionne, mais il tourne sur TROIS QUESTIONS
 * FACTICES. Aucune donnée politique n'existe encore dans le dépôt : ni
 * candidat, ni position, ni source. Les questions viennent de `src/factice/`,
 * jamais de `src/data/`. Publier cette route reviendrait à publier un
 * comparateur qui ne compare rien — le garde-fou de build
 * (`scripts/verifier-pages-publiques.mjs`) le refuse, à raison.
 *
 * Une fois remise dans `src/pages/test/` avec de vraies questions :
 * `noindex` reste en place jusqu'à vérification, en plus du noindex global
 * tant que le site n'est pas publiable. La page de résultat, elle, reste
 * `noindex` pour toujours.
 *
 * Contrainte permanente une fois réactivée : aucun script tiers, aucune police
 * distante, aucun analytics sur cette route. Deux tests de bout en bout la
 * gardent, aujourd'hui en `test.skip` : `aucune-requete-tierce` et
 * `aucune-fuite-de-reponse`.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Quiz from "../../components/Quiz.svelte";
import { validerQuestions } from "../../lib/questions";
import { QUESTIONS_FACTICES } from "../../factice/questions-factices";
import { projeter } from "../../lib/projection";

/*
 * Validation au build. Ce frontmatter ne s'exécute QUE côté serveur : le schéma
 * zod échoue le build si une question est mal formée, sans partir dans le
 * bundle. Une infobulle sans source, un thème vide ou un identifiant en double
 * arrêtent la construction ici.
 */
validerQuestions(QUESTIONS_FACTICES);

/*
 * Projection : l'îlot ne reçoit que ce qui s'affiche. `direction` reste ici,
 * côté serveur, et n'est ni rendu ni embarqué dans le bundle.
 */
const questions = projeter(QUESTIONS_FACTICES);
---

<BaseLayout
  title="Test comparatif"
  description="Le test comparatif de Guide Isoloir tourne sur des questions d'exemple : il n'est pas encore utilisable."
  noindex={true}
>
  <h1>Test comparatif</h1>

  <p>
    Vos réponses et vos résultats ne sont jamais envoyés, enregistrés ou associés à un identifiant.
    Le calcul s'effectue exclusivement dans votre navigateur, et vos réponses disparaissent quand
    vous fermez cet onglet.
  </p>

  <Quiz client:load questions={questions} />

  <noscript>
    <p class="reserve">
      Le test a besoin de JavaScript pour fonctionner : c'est ce qui permet de calculer vos
      résultats dans votre navigateur, sans jamais envoyer vos réponses. La première question
      ci-dessus est lisible, mais vous ne pourrez ni y répondre ni passer à la suivante.
    </p>
    <p class="reserve">
      La <a href="/methodologie">méthodologie</a> décrit la méthode de calcul, et la rubrique
      <a href="/comprendre">Comprendre</a> ne demande aucun JavaScript.
    </p>
  </noscript>

  <p>
    La <a href="/methodologie">méthodologie</a> décrit comment les positions seront établies, et la&#32;<a
      href="/charte-editoriale">charte éditoriale</a
    > comment les candidats seront référencés.
  </p>
</BaseLayout>
