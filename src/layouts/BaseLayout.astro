---
/*
 * Gabarit commun à toutes les pages.
 *
 * La direction visuelle est arrêtée : « Clair », figée dans DESIGN_SYSTEM.md
 * le 22 septembre 2026 et implémentée par src/styles/base.css. Ce fichier
 * n'invente aucune valeur — toute couleur, tout espacement, toute durée passe
 * par un jeton. Une valeur en dur ici serait une décision prise en douce.
 *
 * Deux gabarits : « colonne », le défaut, qui enferme le contenu dans la
 * colonne de lecture ; « libre », où la page compose ses propres sections.
 * L'en-tête et le pied sont IDENTIQUES dans les deux — le garde-fou de build
 * qui vérifie la présence du nom de l'éditeur en dépend.
 *
 * Aucun script tiers, aucune police distante, aucun analytics : la politique
 * de sécurité de public/_headers l'interdit et un test Playwright le vérifie.
 *
 * Les valeurs d'identité (nom de l'éditeur, contact, domaine) peuvent être
 * nulles. Le gabarit omet alors la mention : il n'affiche jamais d'espace
 * réservé. C'est le garde-fou de build qui interdit la publication dans cet
 * état, pas la page qui s'en excuse.
 */
import "../styles/base.css";
import Navigation from "../components/Navigation.astro";
/*
 * URL servie du fichier de police, hachée par le build : la même que celle que
 * base.css référence, puisque Vite ne produit qu'un fichier par contenu.
 */
import policeLatin from "../polices/bricolage-grotesque-latin.woff2?url";
import {
  SITE_NAME,
  SITE_URL,
  SITE_TAGLINE,
  FOOTER_NAV,
  EDITOR_NAME,
  IS_PUBLISHABLE,
} from "../lib/site";

type Props = {
  title: string;
  description: string;
  /** Date ISO `AAAA-MM-JJ` de dernière mise à jour, reprise dans le balisage. */
  updated?: string;
  /** `/resultat` et `/test` ne doivent pas être indexés. */
  noindex?: boolean;
  /**
   * `"colonne"` enferme le contenu dans la colonne de lecture — c'est le cas
   * de toutes les pages de texte, et c'est le défaut. `"libre"` rend le slot
   * sans enveloppe : la page compose alors ses propres sections, chacune
   * choisissant sa largeur et remettant `.enveloppe` autour de son texte long.
   */
  gabarit?: "colonne" | "libre";
  /**
   * Raccourci vers le test dans l'en-tête. Volontairement absent de `/test` et
   * de `/resultat` : il y serait redondant, et chaque lien d'en-tête coûte une
   * tabulation au parcours clavier, dont le budget jusqu'au premier radio du
   * quiz est plafonné à 25 par `tests/e2e/quiz-clavier.spec.ts`.
   */
  actionEntete?: boolean;
};

const {
  title,
  description,
  updated,
  noindex = false,
  gabarit = "colonne",
  actionEntete = true,
} = Astro.props;

const libre = gabarit === "libre";

/*
 * Tant que le site n'est pas publiable — domaine non acheté, éditeur non nommé —
 * TOUTES les pages sont en noindex, pas seulement /test et /resultat.
 *
 * Cloudflare déploie à chaque push, sans attendre la CI. Ce qui est en ligne
 * aujourd'hui est donc un chantier visible, et un chantier indexé serait une
 * dette : des pages sans auteur identifiable sur un sujet YMYL, référencées
 * avant d'être finies. Le noindex tombe tout seul le jour où src/lib/site.ts
 * est renseigné.
 */
const horsIndex = noindex || !IS_PUBLISHABLE;

/*
 * `build.format: "file"` fait apparaître `.html` dans `Astro.url.pathname` au
 * build, alors que le serveur de développement donne l'URL propre. Le canonical
 * doit être identique dans les deux cas, et sans extension.
 */
const cleanPath = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "") || "/";
const canonical = new URL(cleanPath, SITE_URL).href;
const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
  inLanguage: "fr-FR",
  ...(updated ? { dateModified: updated } : {}),
  isPartOf: {
    "@type": "WebSite",
    name: SITE_NAME,
    url: SITE_URL,
  },
  // Aucun `publisher` tant que l'éditeur n'est pas nommé : un balisage
  // `Person` sans nom vaut moins qu'une absence de balisage.
  ...(EDITOR_NAME ? { publisher: { "@type": "Person", name: EDITOR_NAME } } : {}),
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      /*
       * Préchargée avant tout le reste : c'est ce qui permet à `font-display:
       * optional` (voir base.css) de trouver la police prête à la première
       * peinture, et d'éviter la repeinture qui faisait sauter le texte. Seule
       * la plage latine : c'est elle que toutes les pages en français emploient.
       * `crossorigin` est exigé pour une police, même servie par le même site.
       */
    }
    <link rel="preload" href={policeLatin} as="font" type="font/woff2" crossorigin />
    {
      /*
       * Trois icônes, pas une. Le SVG détaille un cadre et deux pans de
       * rideau : à la taille d'un onglet (16-32 px), le filet qui les sépare
       * se perd dans l'anticrénelage et le dessin devient un bloc violet
       * flou. Les PNG reprennent le même signe sur un fond plein, à une
       * échelle pensée pour rester lisible en petit — c'est le traitement de
       * l'icône Apple, étendu aux tailles d'onglet. Voir
       * scripts/generer-marque.mjs.
       *
       * Le SVG reste déclaré en premier pour les agents qui savent en tirer
       * parti (barre d'adresse, favoris) ; les PNG sizés qui suivent sont ce
       * que Chrome et Edge choisissent pour l'onglet lui-même.
       */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {horsIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />

    {
      /*
       * Carte de partage. Une seule pour tout le site : elle porte la marque et
       * la promesse, rien qui dépende de la page. Une carte par page supposerait
       * un rendu au build, donc une image générée pour /resultat — c'est-à-dire
       * une image des réponses de quelqu'un. On s'en tient à une carte fixe.
       *
       * `og:image:alt` n'est pas décoratif : plusieurs lecteurs de flux le lisent
       * à la place de l'image.
       */
    }
    <meta property="og:image" content={new URL("/medias/marque/partage.png", SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — ${SITE_TAGLINE}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      !horsIndex && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
      )
    }
  </head>

  <body>
    <div class="page">
      <a class="evitement" href="#contenu">Aller au contenu</a>

      <Navigation actionEntete={actionEntete} />

      <main class={libre ? "contenu contenu--libre" : "contenu"} id="contenu">
        {
          libre ? (
            <>
              {!IS_PUBLISHABLE && !noindex && (
                <div class="enveloppe-large">
                  <p class="chantier">
                    Site en préparation. Les pages sont mises en ligne au fur et à mesure de leur
                    rédaction, et aucune n'est référencée par les moteurs de recherche.
                  </p>
                </div>
              )}
              <slot />
            </>
          ) : (
            <div class="enveloppe">
              {!IS_PUBLISHABLE && !noindex && (
                <p class="chantier">
                  Site en préparation. Les pages sont mises en ligne au fur et à mesure de leur
                  rédaction, et aucune n'est référencée par les moteurs de recherche.
                </p>
              )}
              <slot />
            </div>
          )
        }
      </main>

      <footer class="pied">
        <div class={libre ? "enveloppe-large" : "enveloppe"}>
          <nav aria-label="Pages d'information">
            <ul>
              {
                FOOTER_NAV.map((entry) => (
                  <li>
                    <a href={entry.href}>{entry.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <p>
            {
              EDITOR_NAME && (
                <>
                  {SITE_NAME} est édité par {EDITOR_NAME}.{" "}
                </>
              )
            }Aucune publicité, aucun analytics, aucun script tiers.
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
