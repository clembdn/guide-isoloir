---
/*
 * Portrait d'un candidat, ou ses initiales à défaut de média libre.
 *
 * UN SEUL COMPOSANT, UN SEUL TRAITEMENT. Même cadre carré, même bordure, même
 * cadrage sur le haut de la photo pour tous : la règle de neutralité des
 * portraits (`CLAUDE.md`, contrainte 5) ne tient que si personne ne peut la
 * contourner en écrivant son propre `<img>`. La liste et la fiche passaient
 * chacune par un balisage recopié ; il n'y en a plus qu'un.
 *
 * Les dimensions sont en attributs, pour que la place soit réservée avant le
 * chargement. Le portrait est décoratif : le nom est toujours écrit à côté.
 *
 * DEUX FICHIERS PAR VISAGE, CHOISIS PAR LA TAILLE, JAMAIS PAR LE CANDIDAT. Le
 * portrait de 330 px pour la fiche et la carte de `/candidats` ; sa vignette de
 * 192 px pour tout ce qui est petit — pages de thème, mosaïque de l'accueil.
 * Vingt-huit visages de 40 px chargeaient 1 Mo ; ils en chargent 150 ko.
 */
import { initiales } from "../../lib/initiales";
import { vignetteDe } from "../../lib/vignettes";

type Props = {
  nom: string;
  chemin: string | null;
  /**
   * Côté du carré, en pixels. Une classe par taille, parce que la CSP refuse
   * tout `style=""` en ligne. 32 et 40 servent aux pages de thème : le tableau
   * récapitulatif et les visages des candidats sans position connue.
   */
  taille: 32 | 40 | 64 | 120 | "carte" | "mosaique";
  /** La fiche charge son portrait tout de suite ; la liste, au défilement. */
  differe?: boolean;
};

const { nom, chemin, taille, differe = true } = Astro.props;

/*
 * « carte » et « mosaique » : le portrait remplit la largeur de sa case, au
 * carré. Les attributs réservent la place avant le chargement (la largeur du
 * fichier servi) ; la CSS fixe la taille réelle.
 */
const petit = taille === "mosaique" || (typeof taille === "number" && taille <= 64);
const source = chemin && petit ? vignetteDe(chemin) : chemin;
const cote = taille === "carte" ? 330 : taille === "mosaique" ? 192 : taille;
---

{
  source ? (
    <img
      class:list={["portrait", `portrait-${taille}`]}
      src={source}
      alt=""
      width={cote}
      height={cote}
      loading={differe ? "lazy" : "eager"}
      decoding="async"
    />
  ) : (
    <span class:list={["portrait", "portrait-absent", `portrait-${taille}`]} aria-hidden="true">
      {initiales(nom)}
    </span>
  )
}

<style>
  .portrait {
    display: block;
    flex: none;
    width: 64px;
    height: 64px;
    margin: 0;
    object-fit: cover;
    object-position: top center;
    border: 1px solid var(--couleur-trait);
    background: var(--couleur-trait);
  }

  .portrait-32 {
    width: 32px;
    height: 32px;
  }

  .portrait-40 {
    width: 40px;
    height: 40px;
  }

  .portrait-120 {
    width: 96px;
    height: 96px;
  }

  @media (min-width: 48rem) {
    .portrait-120 {
      width: 120px;
      height: 120px;
    }
  }

  .portrait-absent {
    display: grid;
    place-items: center;
    font-weight: 700;
    /*
     * Fond de surface, pas la teinte des filets : sur `--couleur-trait`, les
     * initiales en encre faible tombaient à 4,2:1, mesuré par capturer.mjs.
     */
    background: var(--couleur-surface);
    color: var(--couleur-encre-faible);
  }

  .portrait-absent.portrait-120 {
    font-size: 1.5rem;
  }

  .portrait-carte {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  .portrait-absent.portrait-carte {
    font-size: clamp(1.75rem, 1rem + 4vw, 2.75rem);
    letter-spacing: 0.02em;
  }

  .portrait-mosaique {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  .portrait-absent.portrait-mosaique {
    font-size: clamp(0.75rem, 0.55rem + 0.8vw, 1.0625rem);
  }

  .portrait-absent.portrait-32,
  .portrait-absent.portrait-40 {
    font-size: 0.75rem;
  }
</style>
