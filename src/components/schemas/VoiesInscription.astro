---
/*
 * Schéma : les trois voies pour s'inscrire.
 *
 * Trois lignes sous des filets — trois colonnes sur grand écran —, chacune
 * menée par un nœud rond portant son icône. Ce qu'elles ont en commun (les
 * pièces à fournir) va dessous, pour ne pas le répéter trois fois.
 *
 * Les trois arches bordées qui l'ont précédé ont été écartées le 24 septembre
 * 2026 : empilées pleine largeur sur téléphone, elles faisaient trois grands
 * cadres colorés, « trop IA ».
 *
 * Contenu repris de l'article vérifié, sans ajout.
 */
import Icone from "../Icone.astro";

const VOIES = [
  {
    icone: "desktop",
    teinte: "t-indigo",
    titre: "En ligne",
    texte: "Par le téléservice de demande d'inscription, avec une version numérisée des pièces.",
  },
  {
    icone: "bank",
    teinte: "t-sarcelle",
    titre: "En mairie",
    texte:
      "Avec le formulaire cerfa n° 12669. Quelqu'un peut le faire à votre place, avec un pouvoir écrit et signé.",
  },
  {
    icone: "envelope-simple",
    teinte: "t-prune",
    titre: "Par courrier",
    texte: "Avec les mêmes pièces.",
  },
] as const;
---

<figure class="schema">
  <figcaption class="schema-titre">Trois voies, au choix</figcaption>
  <ul class="voies">
    {
      VOIES.map((voie) => (
        <li class:list={["voie", voie.teinte]}>
          <span class="noeud" aria-hidden="true">
            <Icone nom={voie.icone} />
          </span>
          <strong>{voie.titre}</strong>
          <span class="texte">{voie.texte}</span>
        </li>
      ))
    }
  </ul>
  <p class="pieces">
    <Icone nom="identification-card" graisse="bold" />
    <span>
      Dans les trois cas&nbsp;: <strong>un justificatif d'identité</strong> et{" "}
      <strong>un justificatif de domicile de moins de trois mois</strong>.
    </span>
  </p>
</figure>

<style>
  .voies {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .voie {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: var(--pas-2);
    align-items: center;
    margin: 0;
    padding: var(--pas-2) 0;
    border-top: 1px solid var(--couleur-trait);
  }

  .noeud {
    grid-row: span 2;
    align-self: start;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--vif);
    color: var(--couleur-fond);
  }

  .noeud :global(.icone) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .voie strong {
    font-size: 1.0625rem;
    color: var(--vif);
  }

  .texte {
    font-size: var(--t-petit);
    line-height: 1.45;
  }

  @media (min-width: 40rem) {
    .voies {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--couleur-trait);
    }

    .voie {
      grid-template-columns: 1fr;
      align-content: start;
      align-items: start;
      gap: 4px;
      padding: var(--pas-3) var(--pas-3) var(--pas-3) 0;
      border-top: 0;
    }

    .voie + .voie {
      padding-left: var(--pas-3);
      border-left: 1px solid var(--couleur-trait);
    }

    .noeud {
      grid-row: auto;
      margin-bottom: var(--pas-1);
    }
  }

  .pieces {
    display: flex;
    align-items: flex-start;
    gap: var(--pas-2);
    margin: 0;
    padding-top: var(--pas-2);
    border-top: 1px solid var(--couleur-trait);
    font-size: var(--t-petit);
    line-height: 1.45;
  }

  .pieces :global(.icone) {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--couleur-signature);
  }
</style>
