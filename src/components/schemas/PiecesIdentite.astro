---
/*
 * Schéma : quelles pièces d'identité sont acceptées au bureau de vote.
 *
 * Trois groupes, une ligne par pièce sous un filet, l'icône d'une carte
 * d'identité en tête de ligne. Les pièces refusées portent un tampon
 * « Refusée », incliné : le refus se lit par la forme et par le mot, pas par un
 * rouge (famille de parti exclue, et un statut s'écrit).
 *
 * Les petites cartes dessinées à bandeau de couleur, et les cartes tiretées
 * des refus, ont été écartées le 24 septembre 2026 : une pile de cadres
 * colorés, « trop IA », et 1 000 px de haut à 375 px.
 *
 * Trois groupes, et c'est la valeur du schéma : la liste de l'article faisait
 * lire la tolérance des cinq ans comme une règle générale, alors qu'elle ne
 * vaut que pour la carte d'identité et le passeport.
 *
 * Contenu repris de l'article vérifié, sans ajout.
 */
import Icone from "../Icone.astro";

const GROUPES = [
  {
    icone: "clock-countdown",
    teinte: "t-sarcelle",
    titre: "Valides, ou périmées depuis moins de cinq ans",
    pieces: ["Carte nationale d'identité", "Passeport"],
    refus: false,
  },
  {
    icone: "check-circle",
    teinte: "t-indigo",
    titre: "Valides seulement",
    pieces: [
      "Permis de conduire",
      "Carte Vitale avec photographie",
      "Carte de mobilité inclusion, carte du combattant, carte d'identité de fonctionnaire de l'État, avec photographie",
    ],
    refus: false,
  },
  {
    icone: "x-circle",
    teinte: "t-prune",
    titre: "Refusées",
    pieces: [
      "Une photo dans un téléphone, une photocopie : il faut l'original",
      "Un permis de conduire ou une carte de mobilité inclusion périmés",
      "La carte électorale seule : ce n'est pas une pièce d'identité",
    ],
    refus: true,
  },
] as const;
---

<figure class="schema">
  <figcaption class="schema-titre">
    La pièce d'identité, obligatoire dans une commune de 1&nbsp;000 habitants et plus
  </figcaption>
  <div class="groupes">
    {
      GROUPES.map((groupe) => (
        <section class:list={["groupe", groupe.teinte, { "groupe--refus": groupe.refus }]}>
          <h3 class="groupe-titre">
            <Icone nom={groupe.icone} graisse="bold" />
            {groupe.titre}
          </h3>
          <ul class="pieces">
            {groupe.pieces.map((piece) => (
              <li class="piece">
                <Icone nom="identification-card" />
                <span class="piece-nom">
                  {groupe.refus && (
                    <span class="tampon" aria-hidden="true">
                      Refusée
                    </span>
                  )}
                  {piece}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</figure>

<style>
  .groupes {
    display: grid;
    gap: var(--pas-4);
  }

  @media (min-width: 48rem) {
    .groupes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--pas-4);
    }
  }

  .groupe-titre {
    display: flex;
    align-items: flex-start;
    gap: var(--pas-1);
    margin: 0 0 var(--pas-1);
    font-size: 1rem;
    line-height: 1.35;
    color: var(--vif);
  }

  .groupe-titre :global(.icone) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 1px;
  }

  .pieces {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .piece {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    column-gap: var(--pas-2);
    align-items: start;
    margin: 0;
    padding: var(--pas-2) 0;
    border-top: 1px solid var(--couleur-trait);
    font-size: var(--t-petit);
    line-height: 1.4;
  }

  .piece :global(.icone) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--vif);
  }

  /* Une pièce refusée : l'icône s'efface, le tampon parle. */
  .groupe--refus .piece :global(.icone) {
    color: var(--couleur-encre-faible);
  }

  .tampon {
    display: inline-block;
    margin: 0 var(--pas-1) 4px 0;
    padding: 0 6px;
    border: 2px solid var(--vif);
    border-radius: 3px;
    color: var(--vif);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    transform: rotate(-4deg);
  }
</style>
