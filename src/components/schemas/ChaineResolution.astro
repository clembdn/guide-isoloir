---
/*
 * Schéma : la chaîne de résolution des sources, sur un rail vertical.
 *
 * Neuf maillons, du plus fort au plus faible ; le premier disponible
 * l'emporte. Ils sont groupés par ce qu'ils rapportent — ce que le candidat a
 * dit ou fait, ce que dit son camp, une déduction, rien — et la force décroît
 * dans la forme même : nœuds pleins et rail continu tant que la source vient
 * de l'acteur, nœud en contour et rail tireté pour la déduction, nœud tireté
 * vide pour « position inconnue ».
 *
 * L'escalier indenté qui l'a précédé a été écarté le 24 septembre 2026 : à
 * 375 px, le décalage mangeait la largeur et cassait les libellés, et ses
 * cartes pastel à bord coloré faisaient « généré ».
 *
 * LES LIBELLÉS VIENNENT DU MOTEUR (`NIVEAUX_RESOLUTION`), pas d'une copie : ce
 * sont les mêmes mots que la ligne « Origine » sous chaque position des fiches
 * et du résultat. Ils ne peuvent donc pas diverger.
 */
import { NIVEAUX_RESOLUTION } from "../../lib/moteur";

type Groupe = { titre: string; teinte: string; cles: readonly string[] };

const GROUPES: readonly Groupe[] = [
  {
    titre: "Ce que le candidat a dit ou fait",
    teinte: "t-violet",
    cles: [
      "official-program",
      "direct-statement",
      "press-interview",
      "parliamentary-vote",
      "press-report",
    ],
  },
  {
    titre: "Ce que dit son camp",
    teinte: "t-indigo",
    cles: ["coalition-platform", "party-platform"],
  },
  { titre: "Une déduction", teinte: "t-prune", cles: ["inference"] },
];

const marches = NIVEAUX_RESOLUTION.map((niveau) => {
  const groupe = GROUPES.find((g) => g.cles.includes(niveau.cle));
  return {
    rang: niveau.rang,
    libelle: niveau.libelle,
    teinte: groupe?.teinte ?? "t-violet",
    groupe: groupe?.cles[0] === niveau.cle ? groupe.titre : null,
  };
});
---

<figure class="schema">
  <figcaption class="schema-titre">La première source disponible l'emporte</figcaption>
  <ol class="chaine">
    {
      marches.map((marche) => (
        <li class:list={["maillon", marche.teinte, { "maillon--deduit": marche.rang === 8 }]}>
          {marche.groupe && <span class="groupe">{marche.groupe}</span>}
          <span class="noeud">{marche.rang}</span>
          <span class="libelle">{marche.libelle}</span>
        </li>
      ))
    }
    <li class="maillon maillon--inconnu">
      <span class="groupe">Rien</span>
      <span class="noeud">9</span>
      <span class="libelle">Position inconnue</span>
    </li>
  </ol>
</figure>

<style>
  /*
   * Chaque maillon trace le rail jusqu'au suivant : un trait par maillon, et
   * non un seul pour toute la liste, pour que la partie déduite puisse passer
   * en tireté. Le premier part du centre de son nœud, le dernier s'y arrête.
   */
  .chaine {
    --noeud: 2rem;
    --ecart: 0.625rem;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--ecart);
    max-width: 34rem;
  }

  .maillon {
    position: relative;
    display: grid;
    grid-template-columns: var(--noeud) minmax(0, 1fr);
    column-gap: var(--pas-2);
    align-items: center;
    margin: 0;
  }

  .maillon::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: calc(-1 * var(--ecart));
    left: calc(var(--noeud) / 2 - 1.5px);
    border-left: 3px solid var(--couleur-trait);
  }

  .maillon:first-child::before {
    top: calc(var(--noeud) / 2 + 1.25rem);
  }

  .maillon:last-child::before {
    bottom: auto;
    height: calc(1.25rem + var(--pas-2) + var(--noeud) / 2);
  }

  .maillon--deduit::before,
  .maillon--inconnu::before {
    border-left-style: dashed;
  }

  .groupe {
    grid-column: 2;
    margin-top: var(--pas-2);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.25rem;
    color: var(--vif);
  }

  .maillon:first-child .groupe {
    margin-top: 0;
  }

  .noeud {
    position: relative;
    grid-column: 1;
    display: grid;
    place-items: center;
    width: var(--noeud);
    height: var(--noeud);
    border-radius: 50%;
    background: var(--vif);
    color: var(--couleur-fond);
    font-size: 0.8125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .libelle {
    grid-column: 2;
    font-weight: 600;
    line-height: 1.3;
  }

  /* La déduction : le nœud n'est plus qu'un contour. */
  .maillon--deduit .noeud {
    background: var(--couleur-fond);
    border: 2px solid var(--vif);
    color: var(--vif);
  }

  /* Rien : un nœud vide, tireté, dans la couleur des filets. */
  .maillon--inconnu .noeud {
    background: var(--couleur-fond);
    border: 2px dashed var(--couleur-encre-faible);
    color: var(--couleur-encre-faible);
  }

  .maillon--inconnu .groupe,
  .maillon--inconnu .libelle {
    color: var(--couleur-encre-faible);
  }
</style>
