---
/*
 * Schéma : êtes-vous déjà inscrit ? Un aiguillage.
 *
 * Une question en tête, deux voies dessous. À gauche, les deux situations qui
 * donnent une inscription automatique ; à droite, le cas où il faut faire la
 * démarche. C'est la liste de l'article, mise en forme de choix : on se situe
 * au lieu de lire.
 *
 * Dessiné comme les chemins de procuration : un tronc à gauche, une branche à
 * coude par voie, dans sa teinte. La pilule de question, les blocs bordés et
 * les pilules de réponse qui l'ont précédé ont été écartés le 24 septembre
 * 2026 (« trop IA »).
 *
 * Contenu repris de l'article vérifié, sans ajout.
 */
import Icone from "../Icone.astro";
---

<figure class="schema">
  <figcaption class="schema-titre">Êtes-vous déjà inscrit&nbsp;?</figcaption>
  <div class="arbre">
    <p class="question">
      <Icone nom="question" graisse="bold" />
      Vous avez 18 ans, ou les aurez la veille du scrutin
    </p>

    <ul class="voies">
      <li class="voie t-sarcelle">
        <span class="point" aria-hidden="true"></span>
        <p class="condition">Vous êtes dans l'une de ces deux situations</p>
        <ul class="cas">
          <li>
            <Icone nom="student" />
            <span>Vous avez fait votre <strong>recensement citoyen à 16&nbsp;ans</strong></span>
          </li>
          <li class="ou" aria-hidden="true">ou</li>
          <li>
            <Icone nom="identification-card" />
            <span>Vous êtes <strong>devenu français depuis 2019</strong></span>
          </li>
        </ul>
        <p class="issue">
          <Icone nom="seal-check" graisse="fill" />
          Inscription automatique&nbsp;: rien à faire
        </p>
      </li>

      <li class="voie t-prune">
        <span class="point" aria-hidden="true"></span>
        <p class="condition">Aucune des deux</p>
        <p class="issue">
          <Icone nom="hand-pointing" graisse="fill" />
          Il faut vous inscrire&nbsp;: voir plus bas
        </p>
      </li>
    </ul>
  </div>
</figure>

<style>
  /*
   * LE TRONC ET LES COUDES, comme `CheminsProcuration.astro` : un trait
   * vertical sous la question ; chaque voie s'y raccroche par un coude arrondi
   * dans sa teinte, qui finit sur un point.
   */
  .arbre {
    --coude: 3.25rem;
    --tronc: 0.6rem;
    --y-point: calc(var(--pas-3) + 0.7rem);
    max-width: 36rem;
  }

  .question {
    display: flex;
    align-items: flex-start;
    gap: var(--pas-1);
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .question :global(.icone) {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    color: var(--couleur-signature);
  }

  .voies {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .voie {
    position: relative;
    display: grid;
    gap: var(--pas-2);
    margin: 0;
    padding: var(--pas-3) 0 var(--pas-2) var(--coude);
  }

  .voie + .voie {
    border-top: 1px solid var(--couleur-trait);
  }

  .voie::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--tronc);
    width: calc(var(--coude) - var(--tronc) - 26px);
    height: var(--y-point);
    border-left: 3px solid var(--vif);
    border-bottom: 3px solid var(--vif);
    border-bottom-left-radius: 14px;
    z-index: 1;
  }

  .voie:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--tronc);
    width: 3px;
    background: var(--couleur-trait);
  }

  .point {
    position: absolute;
    top: calc(var(--y-point) - 6px);
    left: calc(var(--coude) - 30px);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--vif);
  }

  .condition {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--vif);
  }

  .cas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
    font-size: var(--t-petit);
    line-height: 1.4;
  }

  .cas li {
    display: flex;
    align-items: flex-start;
    gap: var(--pas-1);
    margin: 0;
  }

  .cas :global(.icone) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--vif);
  }

  .ou {
    padding-left: calc(1.25rem + var(--pas-1));
    color: var(--couleur-encre-faible);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .issue {
    display: flex;
    align-items: flex-start;
    gap: var(--pas-1);
    margin: 0;
    font-weight: 700;
    line-height: 1.35;
  }

  .issue :global(.icone) {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    color: var(--vif);
  }
</style>
