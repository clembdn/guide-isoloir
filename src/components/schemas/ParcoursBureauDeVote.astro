---
/*
 * Schéma : le parcours dans un bureau de vote, sur le rail commun des schémas.
 *
 * Six étapes, un nœud par étape avec son icône, dans la teinte de l'étape.
 * L'isoloir est mis en avant par la couleur signature et le signe du site :
 * c'est l'étape qu'on croit facultative, et l'article insiste pour dire
 * qu'elle ne l'est pas. Même TAILLE que les autres nœuds (25 septembre 2026) :
 * plus grand, il cassait l'alignement du rail et jurait avec le reste.
 *
 * Écartés : une ligne droite de stations sans structure (23 septembre 2026) ;
 * six cases bordées en zigzag reliées par des vagues (24 septembre 2026) —
 * 1 300 px de haut à 375 px, et des cartes à bord coloré jugées « trop IA ».
 *
 * C'EST LA LISTE DE L'ARTICLE, PAS UN AJOUT : chaque étape reprend ou resserre
 * ce que l'article vérifié disait déjà, sans fait nouveau. L'ordre du HTML est
 * l'ordre des étapes ; la liste est annoncée comme telle, les numéros et les
 * icônes sont décoratifs.
 */
import Icone from "../Icone.astro";
import signeIsoloir from "../../marque/isoloir.svg?raw";

type Etape = {
  icone: string | null;
  titre: string;
  texte: string;
  teinte: string;
  cle?: boolean;
};

const ETAPES: readonly Etape[] = [
  {
    icone: "user-check",
    titre: "Le contrôle",
    texte: "Le personnel vérifie que vous êtes inscrit dans ce bureau.",
    teinte: "t-sarcelle",
  },
  {
    icone: "envelope-simple",
    titre: "Une enveloppe",
    texte: "Vous prenez une enveloppe.",
    teinte: "t-indigo",
  },
  {
    icone: "files",
    titre: "Au moins deux bulletins",
    texte:
      "Même si votre choix est fait : personne ne doit pouvoir déduire votre vote du nombre de bulletins que vous tenez.",
    teinte: "t-cyan",
  },
  {
    icone: null,
    titre: "L'isoloir",
    texte: "Le passage par l'isoloir n'est pas facultatif.",
    teinte: "t-violet",
    cle: true,
  },
  {
    icone: "box-arrow-down",
    titre: "L'urne",
    texte:
      "Le bureau vérifie votre identité et que vous n'avez qu'une enveloppe. Vous seul avez le droit de la toucher.",
    teinte: "t-prune",
  },
  {
    icone: "signature",
    titre: "La signature",
    texte:
      "Vous signez la liste d'émargement. La date est inscrite sur votre carte électorale, qui vous est rendue.",
    teinte: "t-sarcelle",
  },
];

const isoloir = signeIsoloir
  .replace(/<!--[\s\S]*?-->/, "")
  .replace("<svg ", '<svg aria-hidden="true" focusable="false" class="icone" ');
---

<figure class="schema">
  <figcaption class="schema-titre">Dans le bureau de vote, en six étapes</figcaption>
  <ol class="rail parcours">
    {
      ETAPES.map((etape, index) => (
        <li class:list={[etape.teinte, { "etape--cle": etape.cle }]}>
          <span class="rail-noeud">
            {etape.icone ? <Icone nom={etape.icone} /> : <Fragment set:html={isoloir} />}
          </span>
          <div class="rail-texte">
            <strong>
              <span class="numero" aria-hidden="true">
                {index + 1}.
              </span>{" "}
              {etape.titre}
            </strong>
            <span>{etape.texte}</span>
          </div>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .parcours {
    --noeud: 2.75rem;
    max-width: 36rem;
  }

  .numero {
    color: var(--vif);
    font-variant-numeric: tabular-nums;
  }

  .rail-texte > span {
    display: block;
    margin-top: 2px;
    line-height: 1.45;
  }

  /* L'ISOLOIR : la couleur signature, à la même taille que les autres nœuds. */
  .etape--cle .rail-noeud {
    background: var(--couleur-signature);
  }
</style>
