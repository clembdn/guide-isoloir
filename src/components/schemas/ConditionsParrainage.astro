---
/*
 * Schéma : les trois conditions cumulatives d'un parrainage valide.
 *
 * Trois grands chiffres typographiques, reliés par des « et » posés sur les
 * filets qui les séparent : c'est le mot qui compte, puisque les trois sont
 * exigées à la fois, et que ce sont la deuxième et la troisième qu'on oublie.
 *
 * Les trois doubles cercles qui l'ont précédé ont été écartés le 24 septembre
 * 2026 : 800 px de haut à 375 px pour trois nombres.
 *
 * Contenu repris de l'article vérifié, sans ajout.
 */
const CONDITIONS = [
  {
    teinte: "t-violet",
    chiffre: "500",
    unite: "parrainages",
    texte: "au moins, conformes et validés : 500 personnes différentes, pas 500 mandats",
  },
  {
    teinte: "t-sarcelle",
    chiffre: "30",
    unite: "départements",
    texte: "ou collectivités d'outre-mer, au moins, représentés par les élus signataires",
  },
  {
    teinte: "t-prune",
    chiffre: "< 1/10",
    unite: "d'un même département",
    texte:
      "Moins d'un dixième des parrainages peut venir d'un même département ou d'une même collectivité d'outre-mer",
  },
] as const;
---

<figure class="schema">
  <figcaption class="schema-titre">Trois conditions, toutes à la fois</figcaption>
  <ol class="conditions">
    {
      CONDITIONS.map((condition, index) => (
        <li class:list={["condition", condition.teinte]}>
          {index > 0 && (
            <span class="et" aria-hidden="true">
              et
            </span>
          )}
          <span class="seuil">
            <strong class="chiffre">{condition.chiffre}</strong>
            <span class="unite">{condition.unite}</span>
          </span>
          <span class="texte">{condition.texte}</span>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  /*
   * Téléphone : trois lignes, le chiffre à gauche, le texte à droite. Grand
   * écran : trois colonnes. Les « et » se posent sur les filets de séparation.
   */
  .conditions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .condition {
    position: relative;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    column-gap: var(--pas-3);
    align-items: center;
    margin: 0;
    padding: var(--pas-3) 0;
  }

  .condition + .condition {
    border-top: 1px solid var(--couleur-trait);
  }

  .seuil {
    display: grid;
  }

  .chiffre {
    font-size: 2.5rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--vif);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .unite {
    margin-top: 4px;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .texte {
    font-size: var(--t-petit);
    line-height: 1.45;
  }

  .et {
    position: absolute;
    top: 0;
    left: 0;
    padding-right: var(--pas-1);
    background: var(--couleur-fond);
    color: var(--couleur-encre-faible);
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1;
    transform: translateY(-55%);
  }

  @media (min-width: 48rem) {
    .conditions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .condition {
      grid-template-columns: 1fr;
      align-content: start;
      align-items: start;
      row-gap: var(--pas-2);
      padding: 0 var(--pas-3) 0 0;
    }

    .condition + .condition {
      padding-left: var(--pas-3);
      border-top: 0;
      border-left: 1px solid var(--couleur-trait);
    }

    .et {
      top: 1.25rem;
      left: 0;
      padding: 4px 0;
      transform: translate(-50%, -50%);
    }
  }
</style>
