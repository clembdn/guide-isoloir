---
/*
 * Schéma : les quatre grandeurs que le calcul garde séparées.
 *
 * Quatre lignes séparées par des filets, chacune repérée par une pastille de
 * sa teinte : quatre choses posées côte à côte, jamais versées l'une dans
 * l'autre. Seule la première entre dans le score, et elle le dit en toutes
 * lettres, avec une icône — pas de pilule.
 *
 * Le casier à cloisons épaisses et fonds pastel qui l'a précédé a été écarté
 * le 24 septembre 2026 (« trop IA »).
 *
 * Chaque ligne décrit ce que fait réellement le moteur (`src/lib/moteur/`) :
 * la valeur seule entre dans le score ; l'origine et la confiance ne le
 * touchent jamais ; la couverture s'affiche à côté du score ; l'incertitude se
 * déduit des trois autres.
 */
import Icone from "../Icone.astro";

const GRANDEURS = [
  {
    teinte: "t-violet",
    titre: "La position",
    texte:
      "De « pas du tout d'accord » à « tout à fait d'accord ». La seule qui entre dans le score.",
    score: true,
  },
  {
    teinte: "t-indigo",
    titre: "La qualité des preuves",
    texte:
      "L'origine de la source et la confiance qu'on lui accorde. Elle ne touche jamais au score.",
    score: false,
  },
  {
    teinte: "t-sarcelle",
    titre: "La couverture",
    texte: "Combien d'affirmations sont documentées. Elle s'affiche à côté du score.",
    score: false,
  },
  {
    teinte: "t-cyan",
    titre: "L'incertitude",
    texte: "Déduite des trois autres, et jamais confondue avec la proximité.",
    score: false,
  },
] as const;
---

<figure class="schema">
  <figcaption class="schema-titre">Quatre grandeurs, jamais mélangées</figcaption>
  <ul class="grandeurs">
    {
      GRANDEURS.map((grandeur) => (
        <li class:list={["grandeur", grandeur.teinte]}>
          <strong>
            <span class="pastille" aria-hidden="true" />
            {grandeur.titre}
          </strong>
          <span>{grandeur.texte}</span>
          {grandeur.score && (
            <span class="score">
              <Icone nom="calculator" graisse="bold" />
              Entre dans le score
            </span>
          )}
        </li>
      ))
    }
  </ul>
</figure>

<style>
  /*
   * Téléphone : quatre lignes sous des filets. Grand écran : quatre colonnes
   * séparées par des filets verticaux. Aucun fond, aucun cadre.
   */
  .grandeurs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .grandeur {
    display: grid;
    align-content: start;
    gap: 4px;
    margin: 0;
    padding: var(--pas-2) 0;
    border-top: 1px solid var(--couleur-trait);
    font-size: var(--t-petit);
    line-height: 1.45;
  }

  .grandeur:last-child {
    border-bottom: 1px solid var(--couleur-trait);
  }

  @media (min-width: 48rem) {
    .grandeurs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 1px solid var(--couleur-trait);
      border-bottom: 1px solid var(--couleur-trait);
    }

    .grandeur,
    .grandeur:last-child {
      padding: var(--pas-3) var(--pas-3) var(--pas-3) 0;
      border: 0;
    }

    .grandeur + .grandeur {
      padding-left: var(--pas-3);
      border-left: 1px solid var(--couleur-trait);
    }
  }

  .grandeur strong {
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--vif);
  }

  .pastille {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    margin-right: var(--pas-1);
    border-radius: 50%;
    background: var(--vif);
    vertical-align: 0.02em;
  }

  .score {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-weight: 700;
    color: var(--vif);
  }

  .score :global(.icone) {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
