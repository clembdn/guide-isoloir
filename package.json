{
  "name": "guide-isoloir",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:previsualisation": "GUIDE_ISOLOIR_PREVISUALISATION=1 astro dev",
    "build": "astro build",
    "build:previsualisation": "GUIDE_ISOLOIR_PREVISUALISATION=1 astro build",
    "build:prod": "astro build && node scripts/verifier-pages-publiques.mjs --strict",
    "verify:pages": "node scripts/verifier-pages-publiques.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve:dist": "node scripts/serveur-statique.mjs",
    "ci": "npm run check && npm run lint && npm run test && npm run audit",
    "build:deploy": "npm run ci && npm run build:prod",
    "audit": "vitest run --config vitest.audit.config.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/svelte": "^9.0.1",
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "astro": "^7.3.2",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
